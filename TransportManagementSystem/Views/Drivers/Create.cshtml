@model TransportManagementSystem.Models.Driver

@{
    ViewData["Title"] = "Ajouter un chauffeur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --navy: #0f1c2e;
        --navy-mid: #162436;
        --amber: #f5a623;
        --amber-light: #fbbf24;
        --amber-glow: rgba(245, 166, 35, 0.1);
        --text-muted: #64748b;
    }

    .form-container {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #e2e8f0;
    }

    .page-header {
        margin-bottom: 1.5rem;
    }

        .page-header h1 {
            font-family: 'Sora', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            margin: 0;
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 5px 0 0 0;
        }

    .form-group {
        margin-bottom: 1.25rem;
    }

        .form-group label {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #475569;
            margin-bottom: 0.5rem;
            display: block;
        }

            .form-group label .text-danger {
                color: #ef4444;
            }

    .form-control, .form-select {
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.6rem 0.75rem;
        font-size: 0.9rem;
        transition: all 0.15s;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--amber);
            box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.15);
            outline: none;
        }

    .text-muted {
        font-size: 0.7rem;
        color: #94a3b8 !important;
        margin-top: 0.25rem;
        display: block;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #1d4ed8, #3b82f6);
        border: none;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: transform 0.15s, box-shadow 0.15s;
        color: white;
    }

        .btn-primary-custom:hover {
            background: linear-gradient(135deg, #1e40af, #2563eb);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

    .btn-secondary-custom {
        background: #64748b;
        border: none;
        border-radius: 10px;
        padding: 10px 24px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: background 0.15s;
        color: white;
    }

        .btn-secondary-custom:hover {
            background: #475569;
        }

    .text-danger {
        font-size: 0.75rem;
        margin-top: 0.25rem;
        display: block;
    }

    .alert-info-custom {
        background: #eff6ff;
        border-left: 4px solid #3b82f6;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        margin-bottom: 1.25rem;
        font-size: 0.8rem;
    }

    hr {
        margin: 1.5rem 0;
        border-color: #e2e8f0;
    }

    .required-star {
        color: #ef4444;
        margin-left: 2px;
    }
</style>

<div class="page-header">
    <h1><i class="fas fa-user-plus me-2" style="color: var(--amber);"></i>Ajouter un chauffeur</h1>
    <p>Créez un nouveau conducteur dans le système</p>
</div>

<div class="form-container">
    <form asp-action="Create" id="createForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="alert-info-custom">
            <i class="fas fa-info-circle me-2" style="color: #3b82f6;"></i>
            Les champs marqués d'un <span class="required-star">*</span> sont obligatoires.
        </div>

        <div class="form-group mb-4">
            <label>ID Chauffeur <span class="text-danger">*</span></label>
            <input asp-for="Driver_id" type="number" class="form-control" id="Driver_id" placeholder="Ex: 1001" step="1" />
            <small class="text-muted"><i class="fas fa-lightbulb me-1"></i>ID automatiquement suggéré (modifiable). Doit être unique.</small>
            <span asp-validation-for="Driver_id" class="text-danger"></span>
            <div id="idError" class="text-danger" style="display:none;">
                <i class="fas fa-times-circle me-1"></i>Cet ID existe déjà. Veuillez en choisir un autre.
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Prénom <span class="text-danger">*</span></label>
                    <input asp-for="Driver_FirstName" class="form-control" placeholder="Entrez le prénom" />
                    <span asp-validation-for="Driver_FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Nom <span class="text-danger">*</span></label>
                    <input asp-for="Driver_LastName" class="form-control" placeholder="Entrez le nom" />
                    <span asp-validation-for="Driver_LastName" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Driver_Email" class="form-control" type="email" placeholder="exemple@email.com" />
                    <span asp-validation-for="Driver_Email" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Téléphone</label>
                    <input asp-for="Driver_PhoneNumber" class="form-control" placeholder="+212 6XX XXX XXX" />
                    <span asp-validation-for="Driver_PhoneNumber" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Numéro de permis <span class="text-danger">*</span></label>
                    <input asp-for="Driver_LicenseNumber" class="form-control" placeholder="Ex: P123456" />
                    <span asp-validation-for="Driver_LicenseNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Date d'expiration du permis</label>
                    <input asp-for="Driver_LicenseExpiryDate" type="date" class="form-control" />
                    <span asp-validation-for="Driver_LicenseExpiryDate" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Note / Performance</label>
            <select asp-for="Driver_Rating" class="form-select">
                <option value="Excellent">Excellent</option>
                <option value="Bon">Bon</option>
                <option value="Moyen">Moyen</option>
                <option value="Médiocre">Médiocre</option>
            </select>
            <span asp-validation-for="Driver_Rating" class="text-danger"></span>
        </div>

        <hr />

        <div class="form-group d-flex gap-3 mt-3">
            <input type="submit" value="Créer" class="btn btn-primary-custom" id="submitBtn" />
            <a asp-action="Index" class="btn btn-secondary-custom">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        async function getNextDriverId() {
            try {
                const response = await fetch('/Drivers/GetNextId');
                const data = await response.json();
                return data.nextId;
            } catch (err) {
                console.error('Erreur:', err);
                return 1001;
            }
        }

        async function checkIdExists(id) {
            try {
                const response = await fetch(`/Drivers/CheckIdExists?id=${id}`);
                const data = await response.json();
                return data.exists;
            } catch (err) {
                console.error('Erreur:', err);
                return true;
            }
        }

        async function validateId() {
            const idInput = document.getElementById('Driver_id');
            const idError = document.getElementById('idError');
            const submitBtn = document.getElementById('submitBtn');
            const id = parseInt(idInput.value);

            if (!id || isNaN(id) || id <= 0) {
                idError.style.display = 'block';
                idError.innerText = '❌ Veuillez entrer un ID valide (nombre positif).';
                submitBtn.disabled = true;
                return false;
            }

            const exists = await checkIdExists(id);
            if (exists) {
                idError.style.display = 'block';
                idError.innerText = '❌ Cet ID existe déjà. Veuillez en choisir un autre.';
                submitBtn.disabled = true;
                return false;
            } else {
                idError.style.display = 'none';
                submitBtn.disabled = false;
                return true;
            }
        }

        async function init() {
            const nextId = await getNextDriverId();
            document.getElementById('Driver_id').value = nextId;
            document.getElementById('Driver_id').addEventListener('input', validateId);
            await validateId();
        }

        init();
    </script>
}