@model TransportManagementSystem.Models.Driver

@{
    ViewData["Title"] = "Ajouter un chauffeur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Ajouter un chauffeur</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- ID Field - Manual Entry -->
    <div class="form-group mb-3">
        <label>ID Chauffeur <span class="text-danger">*</span></label>
        <input asp-for="Driver_id" type="number" class="form-control" placeholder="Ex: 1001" />
        <small class="text-muted">Entrez un ID unique pour ce chauffeur</small>
        <span asp-validation-for="Driver_id" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Prénom</label>
                <input asp-for="Driver_FirstName" class="form-control" />
                <span asp-validation-for="Driver_FirstName" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Nom</label>
                <input asp-for="Driver_LastName" class="form-control" />
                <span asp-validation-for="Driver_LastName" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Email</label>
                <input asp-for="Driver_Email" class="form-control" type="email" />
                <span asp-validation-for="Driver_Email" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Téléphone</label>
                <input asp-for="Driver_PhoneNumber" class="form-control" />
                <span asp-validation-for="Driver_PhoneNumber" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Mot de passe temporaire</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Entrez un mot de passe temporaire" />
                <small class="text-muted">Un email sera envoyé pour créer un nouveau mot de passe</small>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Numéro de permis</label>
                <input asp-for="Driver_LicenseNumber" class="form-control" />
                <span asp-validation-for="Driver_LicenseNumber" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Date d'expiration du permis</label>
                <input asp-for="Driver_LicenseExpiryDate" type="date" class="form-control" />
                <span asp-validation-for="Driver_LicenseExpiryDate" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Années d'expérience</label>
                <input asp-for="Driver_ExperienceYears" type="number" class="form-control" />
                <span asp-validation-for="Driver_ExperienceYears" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Statut</label>
                <select asp-for="Driver_Status" class="form-control">
                    <option value="Available">Disponible</option>
                    <option value="On Route">En route</option>
                    <option value="Off Duty">Hors service</option>
                </select>
                <span asp-validation-for="Driver_Status" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Créer" class="btn btn-primary" />
        <a href="/Drivers/Index" class="btn btn-secondary">Retour</a>
    </div>
</form>