@model TransportManagementSystem.Models.Driver

@{
    ViewData["Title"] = "Modifier un chauffeur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Modifier un chauffeur</h1>

@if (ViewBag.Warning != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        ⚠️ @ViewBag.Warning
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">
        ⚠️ @TempData["Warning"]
    </div>
}

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- ID Field - Read-only -->
    <div class="form-group mb-3">
        <label>ID Chauffeur</label>
        <input class="form-control" value="@Model.Driver_id" readonly disabled />
        <input type="hidden" asp-for="Driver_id" />
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Prénom</label>
                <input asp-for="Driver_FirstName" class="form-control" />
                <span asp-validation-for="Driver_FirstName" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Nom</label>
                <input asp-for="Driver_LastName" class="form-control" />
                <span asp-validation-for="Driver_LastName" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Email</label>
                <input asp-for="Driver_Email" class="form-control" type="email" />
                <span asp-validation-for="Driver_Email" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Téléphone</label>
                <input asp-for="Driver_PhoneNumber" class="form-control" />
                <span asp-validation-for="Driver_PhoneNumber" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Numéro de permis</label>
                <input asp-for="Driver_LicenseNumber" class="form-control" />
                <span asp-validation-for="Driver_LicenseNumber" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Date d'expiration du permis</label>
                <input asp-for="Driver_LicenseExpiryDate" type="date" class="form-control" />
                <span asp-validation-for="Driver_LicenseExpiryDate" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Années d'expérience</label>
                <input asp-for="Driver_ExperienceYears" type="number" class="form-control" />
                <span asp-validation-for="Driver_ExperienceYears" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Statut</label>
                <select asp-for="Driver_Status" id="DriverStatus" class="form-control" onchange="checkStatusChange()">
                    <option value="Available">Disponible</option>
                    <option value="On Route">En route</option>
                    <option value="Off Duty">Hors service</option>
                </select>
                <span id="statusWarning" class="text-warning" style="display:none;">
                    ⚠️ Attention: Ce chauffeur est actuellement assigné à un bus.
                    Changer le statut rendra le bus sans chauffeur.
                </span>
                <span asp-validation-for="Driver_Status" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label>Bus actuellement assigné</label>
        <input class="form-control" value="@(Model.AssignedBus?.Bus_Code ?? "Aucun bus assigné")" readonly disabled />
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Enregistrer" class="btn btn-primary" />
        <a href="/Drivers/Index" class="btn btn-secondary">Retour</a>
    </div>
</form>

@section Scripts {
    <script>
        function checkStatusChange() {
            var status = document.getElementById("DriverStatus").value;
            var hasBus = @((Model.Driver_AssignedBusId != null).ToString().ToLower());
            var warningSpan = document.getElementById("statusWarning");
            
            if (hasBus && status !== "On Route" && status !== "Available") {
                warningSpan.style.display = "inline";
            } else {
                warningSpan.style.display = "none";
            }
        }
    </script>
}