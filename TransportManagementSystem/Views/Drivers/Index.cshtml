@model IEnumerable<TransportManagementSystem.Models.Driver>

@{
    ViewData["Title"] = "Chauffeurs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Gestion des Chauffeurs</h1>

<p>
    <a href="/Drivers/Create" class="btn btn-primary">Ajouter un chauffeur</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Email</th>
            <th>Téléphone</th>
            <th>Permis</th>
            <th>Bus assigné</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Driver_id</td>
                <td>@item.Driver_FirstName</td>
                <td>@item.Driver_LastName</td>
                <td>@item.Driver_Email</td>
                <td>@item.Driver_PhoneNumber</td>
                <td>@item.Driver_LicenseNumber</td>
                <td>
                    @if (item.Driver_AssignedBusId.HasValue)
                    {
                        <span class="badge bg-info">Bus @item.Driver_AssignedBusId</span>
                    }
                    else
                    {
                        <span class="text-muted">Non assigné</span>
                    }
                </td>
                <td>
                    @if (item.Driver_Status == "Available")
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else if (item.Driver_Status == "On Route")
                    {
                        <span class="badge bg-warning">En route</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Hors service</span>
                    }
                </td>
                <td>
                    <a href="/Drivers/Edit/@item.Driver_id" class="btn btn-sm btn-warning">Modifier</a>
                    <a href="/Drivers/Delete/@item.Driver_id" class="btn btn-sm btn-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/Dashboard/AdminDashboard" class="btn btn-secondary">Retour au Dashboard</a>