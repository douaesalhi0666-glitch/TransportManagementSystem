@model IEnumerable<TransportManagementSystem.Models.Driver>

@{
    ViewData["Title"] = "Chauffeurs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --navy: #0f1c2e;
        --navy-mid: #162436;
        --navy-light: #1e3250;
        --amber: #f5a623;
        --amber-light: #fbbf24;
        --amber-glow: rgba(245, 166, 35, 0.1);
        --text-muted: #64748b;
    }

    .page-header {
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--amber-glow);
    }

        .page-header h1 {
            font-family: 'Sora', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 4px 0 0 0;
        }

    .btn-primary-custom {
        background: linear-gradient(135deg, #1d4ed8, #3b82f6);
        border: none;
        border-radius: 10px;
        padding: 8px 18px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: transform 0.15s, box-shadow 0.15s;
        color: white;
        text-decoration: none;
        display: inline-block;
    }

        .btn-primary-custom:hover {
            background: linear-gradient(135deg, #1e40af, #2563eb);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
            color: white;
            text-decoration: none;
        }

    .filter-bar {
        background: linear-gradient(135deg, #f8fafc, #ffffff);
        padding: 1.25rem;
        border-radius: 16px;
        margin-bottom: 1.5rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .table-container {
        max-height: calc(100vh - 280px);
        overflow-y: auto;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        position: relative;
    }

    .table-custom {
        font-size: 0.8rem;
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0;
    }

        .table-custom thead {
            position: sticky;
            top: 0;
            background: #f8fafc;
            color: var(--navy);
            z-index: 10;
            border-bottom: 2px solid #e2e8f0;
        }

            .table-custom thead th {
                font-family: 'Sora', sans-serif;
                font-size: 0.8rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                padding: 14px 12px;
                border: none;
                white-space: nowrap;
                color: var(--navy);
            }

        .table-custom tbody td {
            padding: 12px;
            vertical-align: middle;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .table-custom tbody tr:hover {
            background-color: var(--amber-glow);
            transition: background 0.2s;
        }

    .badge-rating {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .badge-excellent {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
    }

    .badge-bon {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
    }

    .badge-moyen {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
    }

    .badge-mediocre {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-sm-custom {
        padding: 5px 12px;
        font-size: 0.7rem;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.15s;
        border: none;
        cursor: pointer;
    }

    .btn-details {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
    }

        .btn-details:hover {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            transform: translateY(-1px);
            box-shadow: 0 2px 6px rgba(59, 130, 246, 0.4);
        }

    .btn-edit {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
    }

        .btn-edit:hover {
            background: linear-gradient(135deg, #d97706, #b45309);
            transform: translateY(-1px);
            box-shadow: 0 2px 6px rgba(245, 158, 11, 0.4);
        }

    .btn-delete {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            transform: translateY(-1px);
            box-shadow: 0 2px 6px rgba(239, 68, 68, 0.4);
        }

    .btn-secondary-custom {
        background: #64748b;
        border: none;
        border-radius: 10px;
        padding: 8px 18px;
        font-weight: 500;
        font-size: 0.85rem;
        transition: background 0.15s;
        color: white;
        text-decoration: none;
        display: inline-block;
    }

        .btn-secondary-custom:hover {
            background: #475569;
            color: white;
            text-decoration: none;
        }

    .export-buttons {
        display: flex;
        gap: 10px;
        margin-left: auto;
    }

    .btn-export-excel {
        background: linear-gradient(135deg, #1e7e34, #28a745);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 8px 18px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: transform 0.15s, box-shadow 0.15s;
        cursor: pointer;
    }

        .btn-export-excel:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(30, 126, 52, 0.3);
        }

    .btn-export-pdf {
        background: linear-gradient(135deg, #c82333, #dc3545);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 8px 18px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: transform 0.15s, box-shadow 0.15s;
        cursor: pointer;
    }

        .btn-export-pdf:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 35, 51, 0.3);
        }

    .search-input:focus, .form-select:focus {
        border-color: var(--amber);
        box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.15);
        outline: none;
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1><i class="fas fa-id-card me-2" style="color: var(--amber);"></i>Gestion des Chauffeurs</h1>
        <p>Gérez les conducteurs et leurs informations</p>
    </div>
    <div>
        <a href="/Drivers/Create" class="btn btn-primary-custom">
            <i class="fas fa-plus me-2"></i>Ajouter un chauffeur
        </a>
    </div>
</div>

<div class="filter-bar">
    <div class="row g-3 align-items-center">
        <div class="col-md-4">
            <input type="text" id="searchInput" class="form-control search-input" placeholder="Rechercher par ID, prénom ou nom" />
        </div>
        <div class="col-md-3">
            <select id="ratingFilter" class="form-select">
                <option value="">Toutes les notes</option>
                <option value="Excellent">Excellent</option>
                <option value="Bon">Bon</option>
                <option value="Moyen">Moyen</option>
                <option value="Médiocre">Médiocre</option>
            </select>
        </div>
        <div class="col-md-2">
            <button id="resetFilter" class="btn btn-secondary-custom w-100">
                <i class="fas fa-undo-alt me-1"></i>Réinitialiser
            </button>
        </div>
        <div class="col-md-3">
            <div class="export-buttons">
                <button id="exportExcelBtn" class="btn-export-excel">
                    <i class="fas fa-file-excel me-2"></i>Excel
                </button>
                <button id="exportPdfBtn" class="btn-export-pdf">
                    <i class="fas fa-file-pdf me-2"></i>PDF
                </button>
            </div>
        </div>
    </div>
</div>

<div class="table-container">
    <table class="table-custom" id="driversTable">
        <thead>
            <tr>
                <th>ID</th>
                <th>Prénom</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Numéro permis</th>
                <th>Expiration permis</th>
                <th>Note</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var ratingClass = item.Driver_Rating == "Excellent" ? "badge-excellent" :
                                 (item.Driver_Rating == "Bon" ? "badge-bon" :
                                 (item.Driver_Rating == "Moyen" ? "badge-moyen" : "badge-mediocre"));

                <tr id="row-@item.Driver_id" data-rating="@item.Driver_Rating">
                    <td>@item.Driver_id</td>
                    <td>@item.Driver_FirstName</td>
                    <td>@item.Driver_LastName</td>
                    <td>@item.Driver_Email</td>
                    <td>@item.Driver_PhoneNumber</td>
                    <td>@item.Driver_LicenseNumber</td>
                    <td>@(item.Driver_LicenseExpiryDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>
                        <span class="badge-rating @ratingClass">
                            @if (item.Driver_Rating == "Excellent")
                            {
                                <i class="fas fa-star me-1"></i>
                            }
                            else if (item.Driver_Rating == "Bon")
                            {

                                <i class="fas fa-star me-1"></i>
                            }
                            else if (item.Driver_Rating == "Moyen")
                            {

                                <i class="fas fa-star-half-alt me-1"></i>
                            }
                            else
                            {

                                <i class="fas fa-star me-1"></i>
                            }
                            @item.Driver_Rating
                        </span>
                    </td>
                    <td class="action-buttons">
                        <button class="btn-sm-custom btn-details details-btn" data-id="@item.Driver_id" data-name="@item.Driver_FirstName @item.Driver_LastName">
                            <i class="fas fa-eye"></i> Détails
                        </button>
                        <button class="btn-sm-custom btn-edit edit-btn" data-id="@item.Driver_id">
                            <i class="fas fa-pen"></i> Modifier
                        </button>
                        <a href="/Drivers/Delete/@item.Driver_id" class="btn-sm-custom btn-delete" onclick="return confirm('Supprimer ce chauffeur ?');">
                            <i class="fas fa-trash"></i> Supprimer
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a href="/Dashboard/AdminDashboard" class="btn btn-secondary-custom">
        <i class="fas fa-arrow-left me-2"></i>Retour au Dashboard
    </a>
</div>

<!-- Modal Détails -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #0f1c2e, #162436); color: white;">
                <h5 class="modal-title"><i class="fas fa-id-card me-2"></i>Détails du chauffeur</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="detailsContent">Chargement...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Modifier -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #0f1c2e, #162436); color: white;">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Modifier le chauffeur</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="edit_Driver_Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-custom">Prénom</label>
                            <input type="text" id="edit_FirstName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Nom</label>
                            <input type="text" id="edit_LastName" class="form-control" required />
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label-custom">Email</label>
                            <input type="email" id="edit_Email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Téléphone</label>
                            <input type="text" id="edit_PhoneNumber" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label-custom">Numéro de permis</label>
                            <input type="text" id="edit_LicenseNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-custom">Date d'expiration</label>
                            <input type="date" id="edit_LicenseExpiryDate" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label-custom">Note</label>
                            <select id="edit_Rating" class="form-select">
                                <option value="Excellent">Excellent</option>
                                <option value="Bon">Bon</option>
                                <option value="Moyen">Moyen</option>
                                <option value="Médiocre">Médiocre</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="saveEditBtn" class="btn btn-primary-custom">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<style>
    .form-label-custom {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #475569;
        margin-bottom: 0.5rem;
        display: block;
    }
</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>

    <script>
        $(document).ready(function() {
        function filterTable() {
        var searchText = $('#searchInput').val().toLowerCase();
        var rating = $('#ratingFilter').val();

        $('#driversTable tbody tr').each(function() {
        var id = $(this).find('td:first').text();
        var firstName = $(this).find('td:nth-child(2)').text();
        var lastName = $(this).find('td:nth-child(3)').text();
        var rowRating = $(this).data('rating');
        var matchSearch = (id.toLowerCase().indexOf(searchText) !== -1) ||
        (firstName.toLowerCase().indexOf(searchText) !== -1) ||
        (lastName.toLowerCase().indexOf(searchText) !== -1);
        var matchRating = (rating === '' || rowRating === rating);
        if (matchSearch && matchRating) $(this).show();
        else $(this).hide();
        });
        }

        $('#searchInput').on('keyup', filterTable);
        $('#ratingFilter').on('change', filterTable);
        $('#resetFilter').click(function() {
        $('#searchInput').val('');
        $('#ratingFilter').val('');
        filterTable();
        });

        // Export Excel
        $('#exportExcelBtn').click(function() {
        var data = [];
        var headers = [];
        $('#driversTable thead th').each(function() {
        var text = $(this).text().trim();
        if (text !== "Actions") headers.push(text);
        });
        data.push(headers);

        $('#driversTable tbody tr:visible').each(function() {
        var row = [];
        $(this).find('td').each(function(index) {
        if (index < 8) row.push($(this).text().trim());
        });
        data.push(row);
        });

        var ws = XLSX.utils.aoa_to_sheet(data);
        var wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Chauffeurs");
        XLSX.writeFile(wb, "Chauffeurs_Export.xlsx");
        });

        // Export PDF
        $('#exportPdfBtn').click(function() {
        const { jsPDF } = window.jspdf;
        var doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
        var columns = [];
        $('#driversTable thead th').each(function() {
        var text = $(this).text().trim();
        if (text !== "Actions") columns.push(text);
        });
        var rows = [];
        $('#driversTable tbody tr:visible').each(function() {
        var row = [];
        $(this).find('td').each(function(index) {
        if (index < 8) row.push($(this).text().trim());
        });
        rows.push(row);
        });
        doc.autoTable({
        head: [columns],
        body: rows,
        theme: 'striped',
        headStyles: { fillColor: [15, 28, 46], textColor: 255, fontStyle: 'bold' },
        margin: { top: 20 },
        didDrawPage: function(data) {
        doc.setFontSize(12);
        doc.setTextColor(100);
        doc.text("Liste des Chauffeurs", data.settings.margin.left, 10);
        }
        });
        doc.save("Chauffeurs_Export.pdf");
        });

        // Details button
        $('.details-btn').click(function() {
        var id = $(this).data('id');
        var name = $(this).data('name');
        $.ajax({
        url: '/Drivers/GetDriverData/' + id,
        type: 'GET',
        success: function(data) {
        var html = `
        <div class="row">
        <div class="col-md-6">
        <div class="card" style="border-radius: 12px; border: 1px solid #e2e8f0;">
        <div class="card-header" style="background: linear-gradient(135deg, #1d4ed8, #3b82f6); color: white; border-radius: 12px 12px 0 0;">
        <i class="fas fa-user me-2"></i>Informations personnelles
        </div>
        <div class="card-body">
        <p><strong>ID:</strong> ${data.driver_id}</p>
        <p><strong>Prénom:</strong> ${data.driver_FirstName}</p>
        <p><strong>Nom:</strong> ${data.driver_LastName}</p>
        <p><strong>Email:</strong> ${data.driver_Email || '-'}</p>
        <p><strong>Téléphone:</strong> ${data.driver_PhoneNumber || '-'}</p>
        </div>
        </div>
        </div>
        <div class="col-md-6">
        <div class="card" style="border-radius: 12px; border: 1px solid #e2e8f0;">
        <div class="card-header" style="background: linear-gradient(135deg, #059669, #10b981); color: white; border-radius: 12px 12px 0 0;">
        <i class="fas fa-id-card me-2"></i>Informations permis
        </div>
        <div class="card-body">
        <p><strong>Numéro permis:</strong> ${data.driver_LicenseNumber || '-'}</p>
        <p><strong>Date d'expiration:</strong> ${data.driver_LicenseExpiryDate ? new Date(data.driver_LicenseExpiryDate).toLocaleDateString() : '-'}</p>
        <p><strong>Note:</strong> ${data.driver_Rating || '-'}</p>
        </div>
        </div>
        </div>
        </div>
        `;
        $('#detailsContent').html(html);
        $('#detailsModal').modal('show');
        },
        error: function() {
        $('#detailsContent').html('<div class="alert alert-danger">Erreur lors du chargement des données.</div>');
        $('#detailsModal').modal('show');
        }
        });
        });

        // Edit button
        $('.edit-btn').click(function() {
        var id = $(this).data('id');
        $.ajax({
        url: '/Drivers/GetDriverData/' + id,
        type: 'GET',
        success: function(data) {
        $('#edit_Driver_Id').val(data.driver_id);
        $('#edit_FirstName').val(data.driver_FirstName);
        $('#edit_LastName').val(data.driver_LastName);
        $('#edit_Email').val(data.driver_Email);
        $('#edit_PhoneNumber').val(data.driver_PhoneNumber);
        $('#edit_LicenseNumber').val(data.driver_LicenseNumber);
        var expiryDate = data.driver_LicenseExpiryDate ? data.driver_LicenseExpiryDate.split('T')[0] : '';
        $('#edit_LicenseExpiryDate').val(expiryDate);
        $('#edit_Rating').val(data.driver_Rating);
        $('#editModal').modal('show');
        },
        error: function() {
        alert('Erreur lors du chargement des données.');
        }
        });
        });

        // Save edit
        $('#saveEditBtn').click(function() {
        var formData = {
        Driver_id: $('#edit_Driver_Id').val(),
        Driver_FirstName: $('#edit_FirstName').val(),
        Driver_LastName: $('#edit_LastName').val(),
        Driver_Email: $('#edit_Email').val(),
        Driver_PhoneNumber: $('#edit_PhoneNumber').val(),
        Driver_LicenseNumber: $('#edit_LicenseNumber').val(),
        Driver_LicenseExpiryDate: $('#edit_LicenseExpiryDate').val() || null,
        Driver_Rating: $('#edit_Rating').val()
        };

        $.ajax({
        url: '/Drivers/UpdateDriver',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(formData),
        success: function(response) {
        if (response.success) {
        alert('Chauffeur mis à jour avec succès !');
        location.reload();
        } else {
        alert('Erreur: ' + (response.message || 'Vérifiez les données'));
        }
        },
        error: function() {
        alert('Erreur lors de l\'envoi.');
        }
        });
        });
        });
    </script>
}