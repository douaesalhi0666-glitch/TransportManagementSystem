@model IEnumerable<TransportManagementSystem.Models.Driver>

@{
    ViewData["Title"] = "Chauffeurs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Gestion des Chauffeurs</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Ajouter un chauffeur</a>
</p>

<!-- Barre de recherche et filtre -->
<div class="row mb-3">
    <div class="col-md-4">
        <input type="text" id="searchInput" class="form-control" placeholder="Rechercher par ID, prénom ou nom" />
    </div>
    <div class="col-md-3">
        <select id="statusFilter" class="form-select">
            <option value="">Tous les statuts</option>
            <option value="Available">Disponible</option>
            <option value="On Route">En route</option>
            <option value="Off Duty">Hors service</option>
        </select>
    </div>
    <div class="col-md-2">
        <button id="resetFilter" class="btn btn-secondary">Réinitialiser</button>
    </div>
</div>

<table class="table table-striped" id="driversTable">
    <thead>
        <tr>
            <th>ID</th>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Email</th>
            <th>Téléphone</th>
            <th>Permis</th>
            <th>Expérience (années)</th>
            <th>Bus assigné</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr id="row-@item.Driver_id" data-status="@item.Driver_Status">
                <td>@item.Driver_id</td>
                <td>@item.Driver_FirstName</td>
                <td>@item.Driver_LastName</td>
                <td>@item.Driver_Email</td>
                <td>@item.Driver_PhoneNumber</td>
                <td>@item.Driver_LicenseNumber</td>
                <td>@(item.Driver_ExperienceYears?.ToString() ?? "—")</td>
                <td>
                    @if (item.AssignedBus != null)
                    {
                        @item.AssignedBus.Bus_Code
                    }
                    else
                    {
                        <span class="text-muted">Non assigné</span>
                    }
                </td>
                <td>
                    @switch (item.Driver_Status)
                    {
                        case "Available":
                            <span class="badge bg-success">Disponible</span>
                            break;
                        case "On Route":
                            <span class="badge bg-warning">En route</span>
                            break;
                        default:
                            <span class="badge bg-danger">Hors service</span>
                            break;
                    }
                </td>
                <td>
                    <button class="btn btn-sm btn-warning edit-btn" data-id="@item.Driver_id">Modifier</button>
                    <form asp-action="Delete" asp-route-id="@item.Driver_id" method="post" style="display:inline;" onsubmit="return confirm('Supprimer définitivement ce chauffeur ?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Dashboard" asp-action="AdminDashboard" class="btn btn-secondary">Retour au Dashboard</a>

<!-- Modal d'édition -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editModalLabel">Modifier le chauffeur</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="edit_Driver_Id" name="Driver_id" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Prénom</label>
                            <input type="text" id="edit_FirstName" name="Driver_FirstName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Nom</label>
                            <input type="text" id="edit_LastName" name="Driver_LastName" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Email</label>
                            <input type="email" id="edit_Email" name="Driver_Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Téléphone</label>
                            <input type="text" id="edit_PhoneNumber" name="Driver_PhoneNumber" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Numéro de permis</label>
                            <input type="text" id="edit_LicenseNumber" name="Driver_LicenseNumber" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Date d'expiration du permis</label>
                            <input type="date" id="edit_LicenseExpiryDate" name="Driver_LicenseExpiryDate" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Années d'expérience</label>
                            <input type="number" id="edit_ExperienceYears" name="Driver_ExperienceYears" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Statut</label>
                            <select id="edit_Status" name="Driver_Status" class="form-select">
                                <option value="Available">Disponible</option>
                                <option value="On Route">En route</option>
                                <option value="Off Duty">Hors service</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label>Bus assigné</label>
                        <select id="edit_BusId" name="Driver_AssignedBusId" class="form-select">
                            <option value="">-- Aucun --</option>
                            @foreach (var bus in ViewBag.Buses)
                            {
                                <option value="@bus.Bus_Id">@bus.Bus_Code - @bus.Bus_PlateNumber</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="saveEditBtn" class="btn btn-primary">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
        // Filtrage par recherche et statut
        function filterTable() {
        var searchText = $('#searchInput').val().toLowerCase();
        var status = $('#statusFilter').val();

        $('#driversTable tbody tr').each(function() {
        var id = $(this).find('td:first').text();
        var firstName = $(this).find('td:nth-child(2)').text();
        var lastName = $(this).find('td:nth-child(3)').text();
        var rowStatus = $(this).data('status');
        var matchSearch = (id.toLowerCase().indexOf(searchText) !== -1) ||
        (firstName.toLowerCase().indexOf(searchText) !== -1) ||
        (lastName.toLowerCase().indexOf(searchText) !== -1);
        var matchStatus = (status === '' || rowStatus === status);
        if (matchSearch && matchStatus) {
        $(this).show();
        } else {
        $(this).hide();
        }
        });
        }

        $('#searchInput').on('keyup', filterTable);
        $('#statusFilter').on('change', filterTable);
        $('#resetFilter').click(function() {
        $('#searchInput').val('');
        $('#statusFilter').val('');
        filterTable();
        });

        // Édition en ligne (modal)
        $('.edit-btn').click(function() {
        var id = $(this).data('id');
        $.get('/Drivers/GetDriverData/' + id, function(data) {
        $('#edit_Driver_Id').val(data.driver_id);
        $('#edit_FirstName').val(data.driver_FirstName);
        $('#edit_LastName').val(data.driver_LastName);
        $('#edit_Email').val(data.driver_Email);
        $('#edit_PhoneNumber').val(data.driver_PhoneNumber);
        $('#edit_LicenseNumber').val(data.driver_LicenseNumber);
        var expiry = data.driver_LicenseExpiryDate ? data.driver_LicenseExpiryDate.split('T')[0] : '';
        $('#edit_LicenseExpiryDate').val(expiry);
        $('#edit_ExperienceYears').val(data.driver_ExperienceYears);
        $('#edit_Status').val(data.driver_Status);
        $('#edit_BusId').val(data.driver_AssignedBusId);
        $('#editModal').modal('show');
        }).fail(function() {
        alert('Erreur lors du chargement des données.');
        });
        });

        $('#saveEditBtn').click(function() {
        var formData = {
        Driver_id: $('#edit_Driver_Id').val(),
        Driver_FirstName: $('#edit_FirstName').val(),
        Driver_LastName: $('#edit_LastName').val(),
        Driver_Email: $('#edit_Email').val(),
        Driver_PhoneNumber: $('#edit_PhoneNumber').val(),
        Driver_LicenseNumber: $('#edit_LicenseNumber').val(),
        Driver_LicenseExpiryDate: $('#edit_LicenseExpiryDate').val() || null,
        Driver_ExperienceYears: $('#edit_ExperienceYears').val() === '' ? null : parseInt($('#edit_ExperienceYears').val()),
        Driver_Status: $('#edit_Status').val(),
        Driver_AssignedBusId: $('#edit_BusId').val() === '' ? null : parseInt($('#edit_BusId').val())
        };

        $.ajax({
        url: '/Drivers/UpdateDriver',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(formData),
        success: function(response) {
        if (response.success) {
        alert(response.message);
        location.reload();
        } else {
        alert('Erreur : ' + (response.message || 'Vérifiez les données'));
        }
        },
        error: function() {
        alert('Erreur lors de l’envoi.');
        }
        });
        });
        });
    </script>
}