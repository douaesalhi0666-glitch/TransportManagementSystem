@model IEnumerable<TransportManagementSystem.Models.Driver>

@{
    ViewData["Title"] = "Chauffeurs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Gestion des Chauffeurs</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Ajouter un chauffeur</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Email</th>
            <th>Téléphone</th>
            <th>Permis</th>
            <th>Expérience (années)</th>
            <th>Bus assigné</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Driver_id</td>
                <td>@item.Driver_FirstName</td>
                <td>@item.Driver_LastName</td>
                <td>@item.Driver_Email</td>
                <td>@item.Driver_PhoneNumber</td>
                <td>@item.Driver_LicenseNumber</td>
                <td>@(item.Driver_ExperienceYears?.ToString() ?? "—")</td>
                <td>
                    @if (item.AssignedBus != null)
                    {
                        @item.AssignedBus.Bus_Code
                    }
                    else
                    {
                        <span class="text-muted">Non assigné</span>
                    }
                </td>
                <td>
                    @switch (item.Driver_Status)
                    {
                        case "Available":
                            <span class="badge bg-success">Disponible</span>
                            break;
                        case "On Route":
                            <span class="badge bg-warning">En route</span>
                            break;
                        default:
                            <span class="badge bg-danger">Hors service</span>
                            break;
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Driver_id" class="btn btn-sm btn-warning">Modifier</a>
                    <a asp-action="Delete" asp-route-id="@item.Driver_id" class="btn btn-sm btn-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Dashboard" asp-action="AdminDashboard" class="btn btn-secondary">Retour au Dashboard</a>