@model TransportManagementSystem.Models.Bus

@{
    ViewData["Title"] = "Supprimer un bus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Supprimer un bus</h1>

<div class="alert alert-danger">
    <h3>Êtes-vous sûr de vouloir supprimer ce bus ?</h3>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Bus_Id</dd>

        <dt class="col-sm-3">Code</dt>
        <dd class="col-sm-9">@Model.Bus_Code</dd>

        <dt class="col-sm-3">Plaque</dt>
        <dd class="col-sm-9">@Model.Bus_PlateNumber</dd>

        <dt class="col-sm-3">Marque</dt>
        <dd class="col-sm-9">@Model.Bus_Brand</dd>

        <dt class="col-sm-3">Modèle</dt>
        <dd class="col-sm-9">@Model.Bus_Model</dd>

        <dt class="col-sm-3">Année</dt>
        <dd class="col-sm-9">@Model.Bus_Year</dd>

        <dt class="col-sm-3">Capacité</dt>
        <dd class="col-sm-9">@Model.Bus_Capacity places</dd>

        <dt class="col-sm-3">Statut</dt>
        <dd class="col-sm-9">@Model.Bus_Status</dd>
    </dl>

    <form method="post" action="/Buses/DeleteConfirmed">
        <input type="hidden" name="id" value="@Model.Bus_Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" />
        <a href="/Buses/Index" class="btn btn-secondary">Retour</a>
    </form>
</div>