@model IEnumerable<TransportManagementSystem.Models.Bus>

@{
    ViewData["Title"] = "Bus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table th, .table td {
        vertical-align: middle;
    }
    .badge-service {
        background-color: #28a745;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
    }
    .badge-maintenance {
        background-color: #ffc107;
        color: #212529;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
    }
    .badge-out {
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
    }
    .filter-bar {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .btn-edit {
        background-color: #ffc107;
        color: #212529;
        margin-right: 5px;
    }
    .btn-delete {
        background-color: #dc3545;
        color: white;
    }
    .details-card {
        margin-bottom: 10px;
    }
    .details-card .card-header {
        font-weight: bold;
    }
</style>

<h1>🚍 Gestion des Bus</h1>

<p>
    <a href="/Buses/Create" class="btn btn-primary">➕ Ajouter un bus</a>
</p>

<div class="filter-bar">
    <div class="row">
        <div class="col-md-4">
            <input type="text" id="searchInput" class="form-control" placeholder="🔍 Rechercher par ID ou Code" />
        </div>
        <div class="col-md-3">
            <select id="statusFilter" class="form-select">
                <option value="">📊 Tous les statuts</option>
                <option value="In Service">✅ En service</option>
                <option value="Maintenance">⚠️ Maintenance</option>
                <option value="Out of Service">❌ Hors service</option>
            </select>
        </div>
        <div class="col-md-2">
            <button id="resetFilter" class="btn btn-secondary w-100">⟳ Réinitialiser</button>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered" id="busesTable">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Plaque</th>
                <th>Marque</th>
                <th>Capacité</th>
                <th>Chauffeur</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.Bus_Id" data-status="@item.Bus_Status">
                    <td>@item.Bus_Id</td>
                    <td><strong>@item.Bus_Code</strong></td>
                    <td>@item.Bus_PlateNumber</td>
                    <td>@item.Bus_Brand</td>
                    <td>@item.Bus_Capacity</td>
                    <td>
                        @if (item.CurrentDriver != null)
                        {
                            <span>👨‍✈️ @item.CurrentDriver.Driver_FirstName @item.CurrentDriver.Driver_LastName</span>
                        }
                        else
                        {
                            <span class="text-muted">⚪ Non assigné</span>
                        }
                    </td>
                    <td>
                        @if (item.Bus_Status == "In Service")
                        {
                            <span class="badge-service">✅ En service</span>
                        }
                        else if (item.Bus_Status == "Maintenance")
                        {
                            <span class="badge-maintenance">⚠️ Maintenance</span>
                        }
                        else
                        {
                            <span class="badge-out">❌ Hors service</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-info details-btn" data-id="@item.Bus_Id" title="Voir détails">🔍 Détails</button>
                        <button class="btn btn-sm btn-edit edit-btn" data-id="@item.Bus_Id" title="Modifier">✏️ Modifier</button>
                        <form asp-action="Delete" asp-route-id="@item.Bus_Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-delete" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce bus ?');" title="Supprimer">🗑️ Supprimer</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a href="/Dashboard/AdminDashboard" class="btn btn-secondary">← Retour au Dashboard</a>
</div>

<!-- Modal d'édition -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editModalLabel">✏️ Modifier le bus</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="edit_Bus_Id" name="Bus_Id" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Code du bus</label>
                            <input type="text" id="edit_Code" name="Bus_Code" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Plaque d'immatriculation</label>
                            <input type="text" id="edit_PlateNumber" name="Bus_PlateNumber" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Marque</label>
                            <input type="text" id="edit_Brand" name="Bus_Brand" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Modèle</label>
                            <input type="text" id="edit_Model" name="Bus_Model" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <label>Année</label>
                            <input type="number" id="edit_Year" name="Bus_Year" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label>Capacité</label>
                            <input type="number" id="edit_Capacity" name="Bus_Capacity" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label>Statut</label>
                            <select id="edit_Status" name="Bus_Status" class="form-select">
                                <option value="In Service">✅ En service</option>
                                <option value="Maintenance">⚠️ Maintenance</option>
                                <option value="Out of Service">❌ Hors service</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Chauffeur assigné</label>
                            <select id="edit_DriverId" name="Bus_CurrentDriverId" class="form-select">
                                <option value="">-- Aucun --</option>
                                @foreach (var driver in ViewBag.Drivers)
                                {
                                    <option value="@driver.Driver_id">👨‍✈️ @driver.Driver_FirstName @driver.Driver_LastName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label>Latitude</label>
                            <input type="text" id="edit_Latitude" name="Bus_CurrentLatitude" class="form-control" placeholder="Latitude" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label>Longitude</label>
                            <input type="text" id="edit_Longitude" name="Bus_CurrentLongitude" class="form-control" placeholder="Longitude" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="saveEditBtn" class="btn btn-primary">💾 Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Détails Bus -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="detailsModalLabel">📋 Détails du bus</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="detailsContent" class="row">
                    <div class="col-12 text-center">Chargement...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            function filterTable() {
                var searchText = $('#searchInput').val().toLowerCase();
                var status = $('#statusFilter').val();

                $('#busesTable tbody tr').each(function() {
                    var id = $(this).find('td:first').text();
                    var code = $(this).find('td:nth-child(2)').text();
                    var rowStatus = $(this).data('status');
                    var matchSearch = (id.toLowerCase().indexOf(searchText) !== -1) || (code.toLowerCase().indexOf(searchText) !== -1);
                    var matchStatus = (status === '' || rowStatus === status);
                    if (matchSearch && matchStatus) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            $('#searchInput').on('keyup', filterTable);
            $('#statusFilter').on('change', filterTable);
            $('#resetFilter').click(function() {
                $('#searchInput').val('');
                $('#statusFilter').val('');
                filterTable();
            });

            // Détails button click
            $('.details-btn').click(function() {
                var id = $(this).data('id');
                $.get('/Buses/GetBusData/' + id, function(data) {
                    var html = `
                        <div class="col-md-6">
                            <div class="card details-card">
                                <div class="card-header bg-primary text-white">Informations générales</div>
                                <div class="card-body">
                                    <p><strong>ID:</strong> ${data.bus_Id}</p>
                                    <p><strong>Code:</strong> ${data.bus_Code}</p>
                                    <p><strong>Plaque:</strong> ${data.bus_PlateNumber}</p>
                                    <p><strong>Marque:</strong> ${data.bus_Brand || '-'}</p>
                                    <p><strong>Modèle:</strong> ${data.bus_Model || '-'}</p>
                                    <p><strong>Année:</strong> ${data.bus_Year || '-'}</p>
                                    <p><strong>Capacité:</strong> ${data.bus_Capacity || '-'} places</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card details-card">
                                <div class="card-header bg-success text-white">Statut et localisation</div>
                                <div class="card-body">
                                    <p><strong>Statut:</strong> 
                                        ${data.bus_Status === 'In Service' ? '✅ En service' : (data.bus_Status === 'Maintenance' ? '⚠️ Maintenance' : '❌ Hors service')}
                                    </p>
                                    <p><strong>Chauffeur:</strong> ${data.bus_CurrentDriverId || 'Non assigné'}</p>
                                    <p><strong>Latitude:</strong> ${data.bus_CurrentLatitude || '-'}</p>
                                    <p><strong>Longitude:</strong> ${data.bus_CurrentLongitude || '-'}</p>
                                </div>
                            </div>
                        </div>
                    `;
                    $('#detailsContent').html(html);
                    $('#detailsModal').modal('show');
                }).fail(function() {
                    $('#detailsContent').html('<div class="col-12 text-center text-danger">❌ Erreur lors du chargement des données.</div>');
                    $('#detailsModal').modal('show');
                });
            });

            $('.edit-btn').click(function() {
                var id = $(this).data('id');
                $.get('/Buses/GetBusData/' + id, function(data) {
                    $('#edit_Bus_Id').val(data.bus_Id);
                    $('#edit_Code').val(data.bus_Code);
                    $('#edit_PlateNumber').val(data.bus_PlateNumber);
                    $('#edit_Brand').val(data.bus_Brand);
                    $('#edit_Model').val(data.bus_Model);
                    $('#edit_Year').val(data.bus_Year);
                    $('#edit_Capacity').val(data.bus_Capacity);
                    $('#edit_Status').val(data.bus_Status);
                    $('#edit_DriverId').val(data.bus_CurrentDriverId);
                    $('#edit_Latitude').val(data.bus_CurrentLatitude);
                    $('#edit_Longitude').val(data.bus_CurrentLongitude);
                    $('#editModal').modal('show');
                }).fail(function() {
                    alert('❌ Erreur lors du chargement des données.');
                });
            });

            $('#saveEditBtn').click(function() {
                var formData = {
                    Bus_Id: $('#edit_Bus_Id').val(),
                    Bus_Code: $('#edit_Code').val(),
                    Bus_PlateNumber: $('#edit_PlateNumber').val(),
                    Bus_Brand: $('#edit_Brand').val(),
                    Bus_Model: $('#edit_Model').val(),
                    Bus_Year: $('#edit_Year').val() === '' ? null : parseInt($('#edit_Year').val()),
                    Bus_Capacity: $('#edit_Capacity').val() === '' ? null : parseInt($('#edit_Capacity').val()),
                    Bus_Status: $('#edit_Status').val(),
                    Bus_CurrentDriverId: $('#edit_DriverId').val() === '' ? null : parseInt($('#edit_DriverId').val()),
                    Bus_CurrentLatitude: $('#edit_Latitude').val() === '' ? null : parseFloat($('#edit_Latitude').val()),
                    Bus_CurrentLongitude: $('#edit_Longitude').val() === '' ? null : parseFloat($('#edit_Longitude').val())
                };

                $.ajax({
                    url: '/Buses/UpdateBus',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function(response) {
                        if (response.success) {
                            alert('✅ ' + response.message);
                            location.reload();
                        } else {
                            alert('❌ Erreur : ' + (response.message || 'Vérifiez les données'));
                        }
                    },
                    error: function() {
                        alert('❌ Erreur lors de l\'envoi.');
                    }
                });
            });
        });
    </script>
}