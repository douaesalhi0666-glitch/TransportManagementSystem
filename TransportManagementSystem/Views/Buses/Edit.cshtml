@model TransportManagementSystem.Models.Bus

@{
    ViewData["Title"] = "Modifier un bus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Modifier un bus</h1>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label>ID Bus</label>
        <input class="form-control" value="@Model.Bus_Id" disabled />
        <input type="hidden" asp-for="Bus_Id" />
    </div>

    <!-- Champs cachés pour préserver les assignations -->
    <input type="hidden" asp-for="Bus_CurrentDriverId" />
    <input type="hidden" asp-for="Bus_CurrentFragmentId" />
    <input type="hidden" asp-for="Bus_CurrentLatitude" />
    <input type="hidden" asp-for="Bus_CurrentLongitude" />
    <input type="hidden" asp-for="Bus_LastLocationUpdateTime" />
    <input type="hidden" asp-for="Bus_CreatedAt" />

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Code du bus</label>
                <input asp-for="Bus_Code" class="form-control" />
                <span asp-validation-for="Bus_Code" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Plaque d'immatriculation</label>
                <input asp-for="Bus_PlateNumber" class="form-control" />
                <span asp-validation-for="Bus_PlateNumber" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Marque</label>
                <input asp-for="Bus_Brand" class="form-control" />
                <span asp-validation-for="Bus_Brand" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Modèle</label>
                <input asp-for="Bus_Model" class="form-control" />
                <span asp-validation-for="Bus_Model" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label>Année</label>
                <input asp-for="Bus_Year" type="number" class="form-control" />
                <span asp-validation-for="Bus_Year" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label>Capacité (places)</label>
                <input asp-for="Bus_Capacity" type="number" class="form-control" />
                <span asp-validation-for="Bus_Capacity" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label>Statut</label>
                <select asp-for="Bus_Status" class="form-control">
                    <option value="In Service">En service</option>
                    <option value="Maintenance">Maintenance</option>
                    <option value="Out of Service">Hors service</option>
                </select>
                <span asp-validation-for="Bus_Status" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Enregistrer" class="btn btn-primary" />
        <a href="/Buses/Index" class="btn btn-secondary">Retour</a>
    </div>
</form>