@{
    ViewData["Title"] = "Accueil";
}

<div class="text-center">
    <h1 class="display-4">Bienvenue dans le Système de Gestion de Transport</h1>
    <p>Gérez votre flotte de bus, vos chauffeurs et votre personnel facilement.</p>
</div>

<div class="row mt-5">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Personnel</h5>
                <p class="card-text">Gérer les employés et leurs affectations</p>
                <a href="/Personnel" class="btn btn-primary">Accéder</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Chauffeurs</h5>
                <p class="card-text">Gérer les chauffeurs et leurs bus</p>
                <a href="/Drivers" class="btn btn-primary">Accéder</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Bus</h5>
                <p class="card-text">Gérer la flotte de véhicules</p>
                <a href="/Buses" class="btn btn-primary">Accéder</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Trajets</h5>
                <p class="card-text">Gérer les itinéraires et horaires</p>
                <a href="/Trajectories" class="btn btn-primary">Accéder</a>
            </div>
        </div>
    </div>
</div>