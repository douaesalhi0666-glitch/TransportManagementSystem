@model IEnumerable<TransportManagementSystem.Models.TrajectoryStop>

@{
    ViewData["Title"] = "Points de ramassage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>🗺️ Gestion des points de ramassage</h2>

<div class="alert alert-info mb-3">
    <strong>📍 Point de départ :</strong> SEWS Maroc (Bir Rami, Kenitra) - Latitude: 34.2900, Longitude: -6.5700
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label>Assignation automatique IA</label>
                <button id="autoAssignAllBtn" class="btn btn-primary w-100 mb-2">
                    🤖 IA: Assigner tous au plus proche
                </button>
                <label>Génération des trajets</label>
                <button id="generateRoutesBtn" class="btn btn-success w-100">
                    🚀 Générer les trajets
                </button>
                <small class="text-muted">Crée des trajets optimisés basés sur les points et la capacité des bus</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label>Capacité maximale par bus</label>
                <input type="number" id="busCapacity" class="form-control" value="20" min="1" max="100" />
                <small class="text-muted">Nombre max de personnels par bus</small>
            </div>
        </div>
    </div>
</div>

<div id="map" style="height: 500px; width: 100%; border-radius: 10px; margin-bottom: 20px;"></div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">📋 Points de ramassage</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="stopsTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Latitude</th>
                        <th>Longitude</th>
                        <th>Ordre</th>
                        <th>Personnels</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="stopsTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Voir personnels -->
<div class="modal fade" id="viewWorkersModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">👥 Personnels assignés</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body"><div id="workersList"></div></div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button></div>
        </div>
    </div>
</div>

<!-- Modal Assigner personnel -->
<div class="modal fade" id="assignWorkerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">➕ Assigner un personnel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="assignStopId" />
                <div class="mb-3"><label>Arrêt</label><input type="text" id="assignStopName" class="form-control" readonly /></div>
                <div class="mb-3"><label>Personnel</label><select id="workerSelect" class="form-control"></select></div>
                <div class="mt-3"><button id="autoAssignToStopBtn" class="btn btn-primary">🤖 IA: Assigner automatiquement</button></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="confirmAssignBtn">Assigner</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Modifier arrêt -->
<div class="modal fade" id="editStopModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning"><h5 class="modal-title">✏️ Modifier l'arrêt</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="editStopId" />
                <div class="mb-3"><label>Nom</label><input type="text" id="editStopName" class="form-control" /></div>
                <div class="row">
                    <div class="col-md-6"><label>Latitude</label><input type="text" id="editStopLat" class="form-control" /></div>
                    <div class="col-md-6"><label>Longitude</label><input type="text" id="editStopLng" class="form-control" /></div>
                </div>
                <div class="mt-3"><label>Ordre</label><input type="number" id="editStopOrder" class="form-control" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="saveStopChanges">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Résultat des trajets -->
<div class="modal fade" id="routesResultModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-success text-white"><h5 class="modal-title">🚀 Trajets générés</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" id="routesResultBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="button" id="saveRoutesBtn" class="btn btn-primary">💾 Sauvegarder</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        .stop-marker { background-color: #28a745; color: white; border-radius: 50%; text-align: center; font-size: 12px; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; border: 2px solid white; cursor: pointer; }
        .sews-marker { background-color: #2ecc71; color: white; border-radius: 50%; text-align: center; font-size: 18px; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border: 3px solid white; cursor: pointer; }
        .toast-notification { position: fixed; bottom: 20px; right: 20px; background-color: #28a745; color: white; padding: 12px 20px; border-radius: 8px; z-index: 10000; }
        .toast-notification.error { background-color: #dc3545; }
        .worker-item { border-left: 3px solid #28a745; margin-bottom: 8px; padding: 10px; background: #f8f9fa; border-radius: 5px; }
    </style>

    <script>
        let map, currentMarkers = [];
        const SEWS_LAT = 34.2900, SEWS_LNG = -6.5700;
        const KENITRA_CENTER_LAT = 34.2610, KENITRA_CENTER_LNG = -6.5800;

        function showNotification(msg, isError = false) {
            let div = document.createElement('div');
            div.className = 'toast-notification' + (isError ? ' error' : '');
            div.innerText = msg;
            document.body.appendChild(div);
            setTimeout(() => { div.style.opacity = '0'; setTimeout(() => div.remove(), 500); }, 3000);
        }

        async function loadData() {
            let response = await fetch('/Clustering/GetFilteredStops');
            let stops = await response.json();
            
            if (!map) { map = L.map('map').setView([KENITRA_CENTER_LAT, KENITRA_CENTER_LNG], 12); L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { attribution: '&copy; OSM' }).addTo(map); }
            
            map.eachLayer(layer => { if (layer instanceof L.Marker) map.removeLayer(layer); });
            currentMarkers = [];
            
            let sewsIcon = L.divIcon({ html: '🏭', iconSize: [40, 40], className: 'sews-marker' });
            L.marker([SEWS_LAT, SEWS_LNG], { icon: sewsIcon }).bindPopup('<strong>🏭 SEWS Maroc</strong>').addTo(map);
            
            stops.forEach(stop => {
                let icon = L.divIcon({ html: stop.tS_OrderIndex.toString(), iconSize: [24, 24], className: 'stop-marker' });
                let popup = `<strong>${stop.tS_Name}</strong><br>Ordre: ${stop.tS_OrderIndex}<br>👥 ${stop.workers?.length || 0} pers.<br>
                    <button class="btn btn-sm btn-success mt-1" onclick="openAssignModal(${stop.tS_Id}, '${stop.tS_Name}')">➕ Assigner</button>
                    <button class="btn btn-sm btn-info mt-1" onclick="viewWorkers(${stop.tS_Id}, '${stop.tS_Name}')">👥 Voir</button>
                    <button class="btn btn-sm btn-warning mt-1" onclick="editStop(${stop.tS_Id}, '${stop.tS_Name}', ${stop.tS_Latitude}, ${stop.tS_Longitude}, ${stop.tS_OrderIndex})">✏️</button>
                    <button class="btn btn-sm btn-danger mt-1" onclick="deleteStop(${stop.tS_Id}, '${stop.tS_Name}')">🗑️</button>`;
                let marker = L.marker([stop.tS_Latitude, stop.tS_Longitude], { icon }).bindPopup(popup).addTo(map);
                currentMarkers.push(marker);
            });
            
            updateTable(stops);
        }

        function updateTable(stops) {
            let tbody = document.getElementById('stopsTableBody');
            tbody.innerHTML = '';
            stops.forEach(s => {
                let row = tbody.insertRow();
                row.insertCell(0).innerHTML = s.tS_Id;
                row.insertCell(1).innerHTML = s.tS_Name;
                row.insertCell(2).innerHTML = s.tS_Latitude;
                row.insertCell(3).innerHTML = s.tS_Longitude;
                row.insertCell(4).innerHTML = s.tS_OrderIndex;
                row.insertCell(5).innerHTML = `<span class="badge bg-info">${s.workers?.length || 0}</span>`;
                row.insertCell(6).innerHTML = `
                    <button class="btn btn-sm btn-success" onclick="openAssignModal(${s.tS_Id}, '${s.tS_Name}')">➕</button>
                    <button class="btn btn-sm btn-info" onclick="viewWorkers(${s.tS_Id}, '${s.tS_Name}')">👥</button>
                    <button class="btn btn-sm btn-warning" onclick="editStop(${s.tS_Id}, '${s.tS_Name}', ${s.tS_Latitude}, ${s.tS_Longitude}, ${s.tS_OrderIndex})">✏️</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteStop(${s.tS_Id}, '${s.tS_Name}')">🗑️</button>`;
            });
        }

        window.viewWorkers = async (stopId, stopName) => {
            let res = await fetch('/Clustering/GetWorkersByStop?stopId=' + stopId);
            let data = await res.json();
            let html = `<h5>${data.stopName}</h5><hr>`;
            if (data.workers?.length) {
                data.workers.forEach(w => {
                    html += `<div class="worker-item"><strong>${w.personnel_FirstName} ${w.personnel_LastName}</strong><br>
                        <small>📞 ${w.personnel_PhoneNumber || '-'}</small><br>
                        <small>🏠 ${w.homeAddress || '-'}</small><br>
                        <button class="btn btn-sm btn-danger mt-2" onclick="removeWorker(${w.personnel_Id}, ${stopId}, '${w.personnel_FirstName} ${w.personnel_LastName}')">❌ Désassigner</button></div>`;
                });
            } else html += '<div class="alert alert-info">Aucun personnel</div>';
            document.getElementById('workersList').innerHTML = html;
            new bootstrap.Modal(document.getElementById('viewWorkersModal')).show();
        };

        window.removeWorker = async (workerId, stopId, name) => {
            if (confirm(`Retirer ${name} ?`)) {
                let res = await fetch('/Clustering/RemoveWorkerFromStop', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ workerId }) });
                let result = await res.json();
                if (result.success) { showNotification(`✅ ${name} désassigné`); bootstrap.Modal.getInstance(document.getElementById('viewWorkersModal')).hide(); loadData(); }
                else showNotification('❌ Erreur', true);
            }
        };

        window.openAssignModal = async (stopId, stopName) => {
            document.getElementById('assignStopId').value = stopId;
            document.getElementById('assignStopName').value = stopName;
            let select = document.getElementById('workerSelect');
            select.innerHTML = '<option>-- Chargement --</option>';
            let res = await fetch('/Clustering/GetUnassignedWorkers');
            let workers = await res.json();
            if (workers.length) {
                select.innerHTML = '<option value="">-- Sélectionner --</option>';
                workers.forEach(w => select.innerHTML += `<option value="${w.personnel_Id}">${w.personnel_FirstName} ${w.personnel_LastName} - ${w.homeAddress || '-'}</option>`);
            } else select.innerHTML = '<option>Aucun personnel disponible</option>';
            new bootstrap.Modal(document.getElementById('assignWorkerModal')).show();
        };

        window.confirmAssign = async () => {
            let stopId = document.getElementById('assignStopId').value;
            let workerId = document.getElementById('workerSelect').value;
            if (!workerId) { showNotification('Sélectionnez un personnel', true); return; }
            let res = await fetch('/Clustering/AssignWorkerToStop', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ workerId: parseInt(workerId), stopId: parseInt(stopId) }) });
            let result = await res.json();
            if (result.success) { showNotification(result.message); bootstrap.Modal.getInstance(document.getElementById('assignWorkerModal')).hide(); loadData(); }
            else showNotification('Erreur', true);
        };

        window.autoAssignToStop = async () => {
            let stopId = document.getElementById('assignStopId').value;
            let stopName = document.getElementById('assignStopName').value;
            if (confirm(`Assigner automatiquement les personnels à ${stopName} ?`)) {
                let res = await fetch(`/Clustering/AutoAssignWorkersToStop?stopId=${stopId}`, { method: 'POST' });
                let result = await res.json();
                if (result.success) { showNotification(result.message); bootstrap.Modal.getInstance(document.getElementById('assignWorkerModal')).hide(); loadData(); }
                else showNotification('Erreur', true);
            }
        };

        window.autoAssignAll = async () => {
            if (confirm('Assigner TOUS les personnels au point le plus proche ?')) {
                let res = await fetch(`/Clustering/AutoAssignAllWorkersToNearestStop?trajectoryId=1`, { method: 'POST' });
                let result = await res.json();
                if (result.success) { showNotification(result.message); loadData(); }
                else showNotification('Erreur', true);
            }
        };

        window.editStop = (id, name, lat, lng, order) => {
            document.getElementById('editStopId').value = id;
            document.getElementById('editStopName').value = name;
            document.getElementById('editStopLat').value = lat;
            document.getElementById('editStopLng').value = lng;
            document.getElementById('editStopOrder').value = order;
            new bootstrap.Modal(document.getElementById('editStopModal')).show();
        };

        window.deleteStop = async (id, name) => {
            if (confirm(`Supprimer "${name}" ?`)) {
                let res = await fetch(`/Clustering/DeleteStop?id=${id}`, { method: 'DELETE' });
                if (res.ok) { showNotification('✅ Supprimé'); loadData(); }
                else showNotification('❌ Erreur', true);
            }
        };

        window.saveStopChanges = async () => {
            let id = document.getElementById('editStopId').value;
            let name = document.getElementById('editStopName').value;
            let lat = parseFloat(document.getElementById('editStopLat').value);
            let lng = parseFloat(document.getElementById('editStopLng').value);
            let order = parseInt(document.getElementById('editStopOrder').value);
            if (!name || isNaN(lat) || isNaN(lng) || isNaN(order)) { showNotification('Champs invalides', true); return; }
            let res = await fetch('/Clustering/UpdateStop', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: parseInt(id), name, latitude: lat, longitude: lng, orderIndex: order }) });
            if (res.ok) { showNotification('✅ Modifié'); bootstrap.Modal.getInstance(document.getElementById('editStopModal')).hide(); loadData(); }
            else showNotification('❌ Erreur', true);
        };

        window.generateRoutes = async () => {
            let capacity = document.getElementById('busCapacity').value;
            showNotification('🔄 Génération...');
            let res = await fetch('/Clustering/GenerateRoutesFromPickupPoints', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ busCapacity: parseInt(capacity) }) });
            let data = await res.json();
            if (data.success) {
                let html = `<div class="alert alert-success">✅ ${data.message}</div>`;
                if (data.routes?.length) {
                    html += `<div class="accordion">`;
                    data.routes.forEach((r, i) => {
                        html += `<div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button ${i>0?'collapsed':''}" data-bs-toggle="collapse" data-bs-target="#c${i}">🚌 Trajet ${i+1} - ${r.totalPassengers} pers. (${r.stops.length} arrêts)</button></h2>
                            <div id="c${i}" class="accordion-collapse collapse ${i==0?'show':''}"><div class="accordion-body">
                            <ul>${r.stops.map(s=>`<li><strong>${s.stopName}</strong> - ${s.passengerCount} pers.</li>`).join('')}</ul>
                            <strong>Personnels:</strong><ul>${r.passengers.map(p=>`<li>${p.firstName} ${p.lastName}</li>`).join('')}</ul>
                            </div></div></div>`;
                    });
                    html += `</div>`;
                }
                document.getElementById('routesResultBody').innerHTML = html;
                new bootstrap.Modal(document.getElementById('routesResultModal')).show();
            } else showNotification('❌ ' + data.message, true);
        };

        window.saveRoutes = async () => {
            let capacity = document.getElementById('busCapacity').value;
            let res = await fetch('/Clustering/SaveGeneratedRoutes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ busCapacity: parseInt(capacity) }) });
            let data = await res.json();
            if (data.success) { showNotification('✅ Trajets sauvegardés'); bootstrap.Modal.getInstance(document.getElementById('routesResultModal')).hide(); }
            else showNotification('❌ ' + data.message, true);
        };

        document.getElementById('autoAssignAllBtn').onclick = autoAssignAll;
        document.getElementById('generateRoutesBtn').onclick = generateRoutes;
        document.getElementById('confirmAssignBtn').onclick = confirmAssign;
        document.getElementById('autoAssignToStopBtn').onclick = autoAssignToStop;
        document.getElementById('saveStopChanges').onclick = saveStopChanges;
        document.getElementById('saveRoutesBtn').onclick = saveRoutes;

        loadData();
    </script>
}