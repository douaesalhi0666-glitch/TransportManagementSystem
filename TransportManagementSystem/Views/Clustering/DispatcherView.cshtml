@{
    ViewData["Title"] = "Regroupement intelligent du personnel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>🗺️ Regroupement intelligent des points du personnel</h2>
<p>Clustering K‑Means ({{k}} clusters) – Cliquez sur un cluster pour créer un arrêt suggéré.</p>

<div class="row mb-3">
    <div class="col-auto">
        <label for="kSlider">Nombre de clusters :</label>
        <input type="range" id="kSlider" min="2" max="10" value="5" step="1" />
        <span id="kValue">5</span>
        <button id="refreshBtn" class="btn btn-primary btn-sm">Actualiser</button>
    </div>
</div>

<div id="map" style="height: 600px; width: 100%; border-radius: 10px;"></div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        .cluster-marker {
        background-color: #ff5722;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 14px;
        font-weight: bold;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        cursor: pointer;
        }

        .person-marker {
        background-color: #1976d2;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 10px;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid white;
        }
    </style>

    <script>
        let map;
        let currentMarkers = { persons: [], clusters: [] };
        let k = 5;

        function getK() { return parseInt(document.getElementById('kSlider').value); }

        async function loadClusters() {
        k = getK();
        document.getElementById('kValue').innerText = k;
        const response = await fetch(`/Clustering/GetClusters?k=${k}`);
        const data = await response.json();

        if (!map) {
        map = L.map('map').setView([46.603354, 1.888334], 6);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> & CartoDB'
        }).addTo(map);
        }

        // Nettoyage
        currentMarkers.persons.forEach(m => map.removeLayer(m));
        currentMarkers.clusters.forEach(m => map.removeLayer(m));
        currentMarkers = { persons: [], clusters: [] };

        // Points du personnel
        data.points.forEach(p => {
        const icon = L.divIcon({ html: '👤', iconSize: [20, 20], className: 'person-marker' });
        const marker = L.marker([p.lat, p.lng], { icon })
        .bindPopup(`${p.name}<br/>ID: ${p.personnelId}`);
        marker.addTo(map);
        currentMarkers.persons.push(marker);
        });

        // Centres de clusters
        data.clusters.forEach((cluster, idx) => {
        const icon = L.divIcon({ html: `${idx+1}`, iconSize: [30, 30], className: 'cluster-marker' });
        const marker = L.marker([cluster.lat, cluster.lng], { icon })
        .bindPopup(`
        <strong>Cluster ${idx+1}</strong><br/>
        ${cluster.size} personnes<br/>
        <button onclick="createStop(${cluster.lat}, ${cluster.lng}, ${idx+1})">Créer un arrêt ici</button>
        `);
        marker.addTo(map);
        currentMarkers.clusters.push(marker);
        });
        }

        window.createStop = async function(lat, lng, clusterId) {
        const name = prompt("Nom de l'arrêt suggéré :", `Cluster ${clusterId}`);
        if (!name) return;
        const res = await fetch('/Clustering/CreateStop', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name, latitude: lat, longitude: lng })
        });
        if (res.ok) {
        alert("Arrêt créé avec succès !");
        loadClusters(); // rafraîchir
        } else {
        alert("Erreur lors de la création.");
        }
        };

        document.getElementById('refreshBtn').addEventListener('click', loadClusters);
        document.getElementById('kSlider').addEventListener('input', function() {
        document.getElementById('kValue').innerText = this.value;
        loadClusters();
        });

        loadClusters();
    </script>
}