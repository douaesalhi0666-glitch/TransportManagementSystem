@model IEnumerable<TransportManagementSystem.Models.TrajectoryStop>

@{
    ViewData["Title"] = "Points de ramassage - Tous les arrêts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>🗺️ Tous les points de ramassage (arrêts) par trajectoire</h2>
<p>Liste et visualisation de tous les arrêts créés pour chaque trajectoire.</p>

<div id="map" style="height: 500px; width: 100%; border-radius: 10px; margin-bottom: 20px;"></div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5>📋 Tableau des arrêts</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped table-bordered" id="stopsTable">
            <thead>
                <tr>
                    <th>ID Trajectoire</th>
                    <th>Trajectoire</th>
                    <th>Code</th>
                    <th>Ordre</th>
                    <th>Nom de l'arrêt</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stop in Model.OrderBy(s => s.TS_TrajectoryId).ThenBy(s => s.TS_OrderIndex))
                {
                    <tr>
                        <td>@stop.TS_TrajectoryId</td>
                        <td>@(stop.Trajectory?.Trajectory_Name)</td>
                        <td>@(stop.Trajectory?.Trajectory_Code)</td>
                        <td>@stop.TS_OrderIndex</td>
                        <td>@stop.TS_Name</td>
                        <td>@stop.TS_Latitude</td>
                        <td>@stop.TS_Longitude</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        .stop-marker {
        background-color: #28a745;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 12px;
        font-weight: bold;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }
    </style>

    <script>
        let map;
        const colorPalette = ['#3388ff', '#ff3333', '#33ff33', '#ff33cc', '#ff9933', '#33cccc', '#9966ff', '#66ff99'];

        async function loadData() {
        const trajResponse = await fetch('/Clustering/GetTrajectoriesWithStops');
        const trajectories = await trajResponse.json();

        const stopsResponse = await fetch('/Clustering/GetAllStops');
        const allStops = await stopsResponse.json();

        if (!map) {
        map = L.map('map').setView([46.603354, 1.888334], 6);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> & CartoDB'
        }).addTo(map);
        }

        map.eachLayer(layer => {
        if (layer instanceof L.Marker || layer instanceof L.Polyline) {
        map.removeLayer(layer);
        }
        });

        trajectories.forEach((traj, idx) => {
        if (traj.stops && traj.stops.length >= 2) {
        const points = traj.stops.map(s => [s.tS_Latitude, s.tS_Longitude]);
        const color = colorPalette[idx % colorPalette.length];
        L.polyline(points, { color: color, weight: 4, opacity: 0.7 })
        .bindPopup(`<strong>${traj.trajectory_Name}</strong><br>${traj.trajectory_Code}`)
        .addTo(map);
        }
        });

        allStops.forEach(stop => {
        const icon = L.divIcon({
        html: stop.tS_OrderIndex.toString(),
        iconSize: [24, 24],
        className: 'stop-marker'
        });
        const popupContent = `<strong>${stop.tS_Name}</strong><br/>
        Trajectoire: ${stop.trajectoryName}<br/>
        Ordre: ${stop.tS_OrderIndex}<br/>
        Coordonnées: ${stop.tS_Latitude}, ${stop.tS_Longitude}`;
        L.marker([stop.tS_Latitude, stop.tS_Longitude], { icon })
        .bindPopup(popupContent)
        .addTo(map);
        });

        if (allStops.length > 0) {
        const latLngs = allStops.map(s => [s.tS_Latitude, s.tS_Longitude]);
        const bounds = L.latLngBounds(latLngs);
        map.fitBounds(bounds);
        }
        }

        loadData();
    </script>
}