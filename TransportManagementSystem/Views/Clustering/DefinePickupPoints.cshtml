@{
    ViewData["Title"] = "Points de ramassage - Gestion complète";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>📍 Gestion des points de ramassage</h2>
<p>Cliquez sur la carte pour ajouter un point, ou utilisez l'IA pour suggérer des points. Assignez les personnels aux points existants.</p>
<p class="text-muted">🏭 <strong>Point de départ commun : SEWS Maroc (Bir Rami, Kenitra)</strong> - Latitude: 34.2900, Longitude: -6.5700</p>

<div class="row mb-3">
    <div class="col-md-4">
        <!-- Filtre par trajectoire -->
        <div class="card mb-3">
            <div class="card-header bg-dark text-white">
                <h5>🔍 Filtrer par trajectoire</h5>
            </div>
            <div class="card-body">
                <select id="trajectoryFilter" class="form-control">
                    <option value="all">-- Toutes les trajectoires --</option>
                </select>
                <button id="refreshFilterBtn" class="btn btn-secondary w-100 mt-2">🔄 Appliquer le filtre</button>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5>➕ Ajouter un point manuellement</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label>Nom du point de ramassage</label>
                    <input type="text" id="stopName" class="form-control" placeholder="Ex: Point 1 - Centre ville" />
                </div>
                <div class="mb-3">
                    <label>Latitude</label>
                    <input type="text" id="stopLat" class="form-control" readonly placeholder="Cliquez sur la carte" />
                </div>
                <div class="mb-3">
                    <label>Longitude</label>
                    <input type="text" id="stopLng" class="form-control" readonly placeholder="Cliquez sur la carte" />
                </div>
                <button id="btnAddStop" class="btn btn-success w-100" disabled>
                    📍 Ajouter ce point (cliquez sur la carte d'abord)
                </button>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header bg-info text-white">
                <h5>🤖 Génération IA</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label>Nombre de points suggérés</label>
                    <input type="number" id="kValue" class="form-control" value="4" min="1" max="10" />
                </div>
                <button id="btnCompute" class="btn btn-primary w-100">
                    🧠 Suggérer des points par IA
                </button>
                <div id="infoPanel" class="mt-3"></div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5>🤖 Assignation IA globale</h5>
            </div>
            <div class="card-body">
                <button id="autoAssignAllBtn" class="btn btn-warning w-100">
                    🚀 Assigner tous les personnels au point le plus proche
                </button>
                <small class="text-muted d-block mt-2">Assigne automatiquement chaque personnel non assigné au point de ramassage le plus proche.</small>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5>🗺️ Carte - 🏭 SEWS (vert) | 🟠 Points existants | 🟣 Points suggérés</h5>
            </div>
            <div class="card-body">
                <div id="map" style="height: 500px; border-radius: 10px;"></div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">📋 Tableau des points de ramassage</h5>
        <button id="refreshTableBtn" class="btn btn-sm btn-light">🔄 Rafraîchir</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="stopsTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Latitude</th>
                        <th>Longitude</th>
                        <th>Ordre</th>
                        <th>Personnels</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="stopsTableBody">
                    <tr><td colspan="7" class="text-center">Chargement...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modals -->
<div class="modal fade" id="viewWorkersModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">👥 Personnels assignés à l'arrêt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body"><div id="workersList"></div></div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="assignWorkerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">➕ Assigner un personnel à l'arrêt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="assignStopId" />
                <input type="hidden" id="assignStopNameHidden" />
                <div class="mb-3">
                    <label>Arrêt</label>
                    <input type="text" id="assignStopNameDisplay" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label>Personnel non assigné</label>
                    <select id="workerSelect" class="form-control"></select>
                </div>
                <div class="mt-3">
                    <button id="autoAssignToStopBtn" class="btn btn-primary w-100">🤖 IA: Assigner automatiquement les personnels proches</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="confirmAssignBtn">Assigner</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editStopModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">✏️ Modifier l'arrêt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editStopId" />
                <div class="mb-3">
                    <label>Nom de l'arrêt</label>
                    <input type="text" id="editStopName" class="form-control" />
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label>Latitude</label>
                        <input type="text" id="editStopLat" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label>Longitude</label>
                        <input type="text" id="editStopLng" class="form-control" />
                    </div>
                </div>
                <div class="mt-3">
                    <label>Ordre</label>
                    <input type="number" id="editStopOrder" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="saveStopChanges">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        .existing-stop-marker {
        background-color: #ff8c00;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 12px;
        font-weight: bold;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        cursor: pointer;
        }

        .suggested-marker {
        background-color: #9b59b6;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 12px;
        font-weight: bold;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        cursor: pointer;
        }

        .sews-marker {
        background-color: #2ecc71;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 18px;
        font-weight: bold;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        cursor: pointer;
        }

        .toast-notification {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background-color: #28a745;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        z-index: 10000;
        }

        .toast-notification.error {
        background-color: #dc3545;
        }

        .worker-item {
        border-left: 3px solid #28a745;
        margin-bottom: 8px;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 5px;
        }

        .click-instruction {
        position: absolute;
        bottom: 20px;
        left: 20px;
        background: rgba(0,0,0,0.7);
        color: white;
        padding: 8px 12px;
        border-radius: 5px;
        font-size: 12px;
        z-index: 1000;
        pointer-events: none;
        }
    </style>

    <script>
        let map;
        let currentMarkers = { existing: [], suggested: [], sews: [] };
        const SEWS_LAT = 34.2900;
        const SEWS_LNG = -6.5700;
        const KENITRA_CENTER_LAT = 34.2610;
        const KENITRA_CENTER_LNG = -6.5800;
        const DEFAULT_TRAJECTORY_ID = 1;

        function showNotification(message, isError = false) {
        const div = document.createElement('div');
        div.className = 'toast-notification' + (isError ? ' error' : '');
        div.innerText = message;
        document.body.appendChild(div);
        setTimeout(() => { div.style.opacity = '0'; setTimeout(() => div.remove(), 500); }, 3000);
        }

        async function loadTrajectoriesFilter() {
        const response = await fetch('/Clustering/GetTrajectoriesForPickup');
        const trajectories = await response.json();
        const filter = document.getElementById('trajectoryFilter');
        filter.innerHTML = '<option value="all">-- Toutes les trajectoires --</option>';
        trajectories.forEach(t => {
        const option = document.createElement('option');
        option.value = t.trajectory_Id;
        option.textContent = `${t.trajectory_Name} (${t.trajectory_Code})`;
        filter.appendChild(option);
        });
        const defaultTraj = Array.from(filter.options).find(opt => opt.value == DEFAULT_TRAJECTORY_ID);
        if (defaultTraj) filter.value = DEFAULT_TRAJECTORY_ID;
        await loadExistingStops();
        }

        async function loadExistingStops() {
        const selectedTraj = document.getElementById('trajectoryFilter').value;
        const url = selectedTraj === 'all'
        ? '/Clustering/GetFilteredStops'
        : `/Clustering/GetFilteredStops?trajectoryId=${selectedTraj}`;
        console.log("Chargement des stops depuis :", url);
        try {
        const response = await fetch(url);
        const stops = await response.json();
        console.log(`Nombre de stops reçus : ${stops.length}`);
        if (!stops.length) {
        showNotification("Aucun point de ramassage trouvé pour cette trajectoire.", false);
        return;
        }
        if (currentMarkers.existing) currentMarkers.existing.forEach(m => map.removeLayer(m));
        currentMarkers.existing = [];
        stops.forEach(stop => {
        const icon = L.divIcon({
        html: stop.tS_OrderIndex.toString(),
        iconSize: [28, 28],
        className: 'existing-stop-marker'
        });
        const workerCount = stop.workers ? stop.workers.length : 0;
        const popupContent = `
        <strong>${stop.tS_Name}</strong><br>
        Ordre: ${stop.tS_OrderIndex}<br>
        👥 Personnels assignés: ${workerCount}<br>
        📍 ${stop.tS_Latitude}, ${stop.tS_Longitude}<br>
        <button class="btn btn-sm btn-primary mt-1" onclick="editStop(${stop.tS_Id}, '${escapeHtml(stop.tS_Name)}', ${stop.tS_Latitude}, ${stop.tS_Longitude}, ${stop.tS_OrderIndex})">✏️ Modifier</button>
        <button class="btn btn-sm btn-danger mt-1" onclick="deleteStop(${stop.tS_Id}, '${escapeHtml(stop.tS_Name)}')">🗑️ Supprimer</button>
        <button class="btn btn-sm btn-success mt-1" onclick="openAssignModal(${stop.tS_Id}, '${escapeHtml(stop.tS_Name)}')">👥 Assigner</button>
        <button class="btn btn-sm btn-info mt-1" onclick="viewWorkers(${stop.tS_Id}, '${escapeHtml(stop.tS_Name)}')">📋 Voir</button>
        `;
        const marker = L.marker([stop.tS_Latitude, stop.tS_Longitude], { icon }).bindPopup(popupContent);
        marker.addTo(map);
        currentMarkers.existing.push(marker);
        });
        updateTable(stops);
        map.invalidateSize();
        } catch (err) {
        console.error(err);
        showNotification("Erreur lors du chargement des points", true);
        }
        }

        function updateTable(stops) {
        const tbody = document.getElementById('stopsTableBody');
        tbody.innerHTML = '';
        if (!stops || stops.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center">Aucun point de ramassage</td></tr>';
        return;
        }
        stops.forEach(stop => {
        const row = tbody.insertRow();
        const workerCount = stop.workers ? stop.workers.length : 0;
        row.insertCell(0).innerHTML = stop.tS_Id;
        row.insertCell(1).innerHTML = escapeHtml(stop.tS_Name);
        row.insertCell(2).innerHTML = stop.tS_Latitude;
        row.insertCell(3).innerHTML = stop.tS_Longitude;
        row.insertCell(4).innerHTML = stop.tS_OrderIndex;
        row.insertCell(5).innerHTML = `<span class="badge bg-info">${workerCount} personnels</span>`;
        row.insertCell(6).innerHTML = `
        <button class="btn btn-sm btn-primary" onclick="editStop(${stop.tS_Id}, '${escapeHtml(stop.tS_Name)}', ${stop.tS_Latitude}, ${stop.tS_Longitude}, ${stop.tS_OrderIndex})">✏️</button>
        <button class="btn btn-sm btn-danger" onclick="deleteStop(${stop.tS_Id}, '${escapeHtml(stop.tS_Name)}')">🗑️</button>
        <button class="btn btn-sm btn-success" onclick="openAssignModal(${stop.tS_Id}, '${escapeHtml(stop.tS_Name)}')">👥</button>
        <button class="btn btn-sm btn-info" onclick="viewWorkers(${stop.tS_Id}, '${escapeHtml(stop.tS_Name)}')">📋</button>
        `;
        });
        }

        function escapeHtml(text) {
        if (!text) return '';
        return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        window.viewWorkers = async function(stopId, stopName) {
        try {
        const response = await fetch('/Clustering/GetWorkersByStop?stopId=' + stopId);
        const data = await response.json();
        const workersListDiv = document.getElementById('workersList');
        if (data.workers && data.workers.length > 0) {
        let html = '<h5>Arrêt: ' + data.stopName + '</h5><hr>';
        data.workers.forEach(worker => {
        html += `
        <div class="worker-item">
        <strong>${worker.personnel_FirstName} ${worker.personnel_LastName}</strong><br>
        <small>📞 ${worker.personnel_PhoneNumber || 'Non renseigné'}</small><br>
        <small>📧 ${worker.personnel_Email || 'Non renseigné'}</small><br>
        <small>🏠 ${worker.homeAddress || 'Adresse non renseignée'}</small><br>
        <button class="btn btn-sm btn-danger remove-worker-btn" onclick="removeWorkerFromStop(${worker.personnel_Id}, ${stopId}, '${worker.personnel_FirstName} ${worker.personnel_LastName}')">
        ❌ Désassigner
        </button>
        </div>
        `;
        });
        workersListDiv.innerHTML = html;
        } else {
        workersListDiv.innerHTML = '<div class="alert alert-info">Aucun personnel assigné à cet arrêt.</div>';
        }
        new bootstrap.Modal(document.getElementById('viewWorkersModal')).show();
        } catch (error) {
        showNotification('Erreur lors du chargement des personnels.', true);
        }
        };

        window.removeWorkerFromStop = async function(workerId, stopId, workerName) {
        if (confirm(`Retirer ${workerName} de ce point de ramassage ?`)) {
        try {
        const response = await fetch('/Clustering/RemoveWorkerFromStop', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ workerId: workerId })
        });
        const result = await response.json();
        if (result.success) {
        showNotification(`✅ ${workerName} a été désassigné.`);
        bootstrap.Modal.getInstance(document.getElementById('viewWorkersModal')).hide();
        await loadExistingStops();
        } else {
        showNotification('❌ Erreur: ' + result.message, true);
        }
        } catch (err) {
        showNotification('❌ Erreur réseau.', true);
        }
        }
        };

        window.editStop = async function(id, name, lat, lng, order) {
        document.getElementById('editStopId').value = id;
        document.getElementById('editStopName').value = name;
        document.getElementById('editStopLat').value = lat;
        document.getElementById('editStopLng').value = lng;
        document.getElementById('editStopOrder').value = order;
        new bootstrap.Modal(document.getElementById('editStopModal')).show();
        };

        window.deleteStop = async function(id, name) {
        if (confirm(`Supprimer le point "${name}" ?`)) {
        try {
        const response = await fetch(`/Clustering/DeleteStop?id=${id}`, { method: 'DELETE' });
        if (response.ok) {
        showNotification(`✅ Point "${name}" supprimé !`);
        await loadExistingStops();
        } else {
        const errorData = await response.json();
        showNotification("❌ " + (errorData.message || "Erreur lors de la suppression."), true);
        }
        } catch (err) {
        showNotification("❌ Erreur réseau.", true);
        }
        }
        };

        window.openAssignModal = async function(stopId, stopName) {
        document.getElementById('assignStopId').value = stopId;
        document.getElementById('assignStopNameDisplay').value = stopName;
        document.getElementById('assignStopNameHidden').value = stopName;
        const workerSelect = document.getElementById('workerSelect');
        workerSelect.innerHTML = '<option value="">-- Chargement... --</option>';
        try {
        const response = await fetch('/Clustering/GetUnassignedWorkers');
        const workers = await response.json();
        if (workers.length > 0) {
        workerSelect.innerHTML = '<option value="">-- Sélectionner un personnel --</option>';
        workers.forEach(w => {
        workerSelect.innerHTML += `<option value="${w.personnel_Id}">${w.personnel_FirstName} ${w.personnel_LastName} - ${w.homeAddress || 'Adresse inconnue'}</option>`;
        });
        } else {
        workerSelect.innerHTML = '<option value="">Aucun personnel non assigné disponible</option>';
        }
        } catch (err) {
        workerSelect.innerHTML = '<option value="">Erreur de chargement</option>';
        }
        new bootstrap.Modal(document.getElementById('assignWorkerModal')).show();
        };

        async function confirmAssign() {
        const stopId = document.getElementById('assignStopId').value;
        const workerId = document.getElementById('workerSelect').value;
        if (!workerId) {
        showNotification('Veuillez sélectionner un personnel.', true);
        return;
        }
        try {
        const response = await fetch('/Clustering/AssignWorkerToStop', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ workerId: parseInt(workerId), stopId: parseInt(stopId) })
        });
        const result = await response.json();
        if (result.success) {
        showNotification(result.message);
        bootstrap.Modal.getInstance(document.getElementById('assignWorkerModal')).hide();
        await loadExistingStops();
        } else {
        showNotification('Erreur: ' + result.message, true);
        }
        } catch (err) {
        showNotification('Erreur réseau.', true);
        }
        }

        async function autoAssignToStop() {
        const stopId = document.getElementById('assignStopId').value;
        const stopName = document.getElementById('assignStopNameDisplay').value;
        if (confirm(`Assigner automatiquement les personnels proches à l'arrêt ${stopName} ?`)) {
        try {
        const response = await fetch(`/Clustering/AutoAssignWorkersToStop?stopId=${stopId}`, { method: 'POST' });
        const result = await response.json();
        if (result.success) {
        showNotification(result.message);
        bootstrap.Modal.getInstance(document.getElementById('assignWorkerModal')).hide();
        await loadExistingStops();
        } else {
        showNotification('Erreur: ' + result.message, true);
        }
        } catch (err) {
        showNotification('Erreur réseau.', true);
        }
        }
        }

        async function autoAssignAll() {
        if (confirm('Assigner automatiquement TOUS les personnels non assignés à l\'arrêt le plus proche ?')) {
        try {
        const response = await fetch(`/Clustering/AutoAssignAllWorkersToNearestStop?trajectoryId=${DEFAULT_TRAJECTORY_ID}`, { method: 'POST' });
        const result = await response.json();
        if (result.success) {
        showNotification(result.message);
        await loadExistingStops();
        } else {
        showNotification('Erreur: ' + result.message, true);
        }
        } catch (err) {
        showNotification('Erreur réseau.', true);
        }
        }
        }

        async function saveStopChanges() {
        const id = document.getElementById('editStopId').value;
        const name = document.getElementById('editStopName').value;
        const lat = parseFloat(document.getElementById('editStopLat').value);
        const lng = parseFloat(document.getElementById('editStopLng').value);
        const order = parseInt(document.getElementById('editStopOrder').value);
        if (!name || isNaN(lat) || isNaN(lng) || isNaN(order)) {
        showNotification('Veuillez remplir tous les champs correctement.', true);
        return;
        }
        try {
        const response = await fetch('/Clustering/UpdateStop', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(id), name: name, latitude: lat, longitude: lng, orderIndex: order })
        });
        if (response.ok) {
        showNotification('✅ Arrêt modifié avec succès !');
        bootstrap.Modal.getInstance(document.getElementById('editStopModal')).hide();
        await loadExistingStops();
        } else {
        showNotification('❌ Erreur lors de la modification.', true);
        }
        } catch (err) {
        showNotification('❌ Erreur réseau.', true);
        }
        }

        function clearSuggestedMarkers() {
        if (currentMarkers.suggested) currentMarkers.suggested.forEach(m => map.removeLayer(m));
        currentMarkers.suggested = [];
        }

        function addSEWSMarker() {
        const sewsIcon = L.divIcon({ html: '🏭', iconSize: [40, 40], className: 'sews-marker' });
        const marker = L.marker([SEWS_LAT, SEWS_LNG], { icon: sewsIcon })
        .bindPopup('<strong>🏭 SEWS Maroc</strong><br>Point de départ');
        marker.addTo(map);
        currentMarkers.sews.push(marker);
        }

        async function loadPickupPoints() {
        const k = document.getElementById('kValue').value;
        const response = await fetch('/Clustering/SuggestPickupPoints', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trajectoryId: DEFAULT_TRAJECTORY_ID, numberOfClusters: parseInt(k) })
        });
        const data = await response.json();
        clearSuggestedMarkers();
        if (data.clusters && data.clusters.length > 0) {
        for (const c of data.clusters) {
        let alreadyExists = false;
        if (currentMarkers.existing) {
        for (const marker of currentMarkers.existing) {
        const latLng = marker.getLatLng();
        const distance = Math.sqrt(Math.pow(latLng.lat - c.lat, 2) + Math.pow(latLng.lng - c.lng, 2));
        if (distance < 0.001) { alreadyExists = true; break; }
        }
        }
        if (alreadyExists || c.exists) continue;
        const idx = currentMarkers.suggested.length + 1;
        const icon = L.divIcon({ html: idx.toString(), iconSize: [28, 28], className: 'suggested-marker' });
        let popupContent = `<strong>Point suggéré ${idx}</strong><br>${c.count} personnes proches<br>`;
        popupContent += `<button onclick="createSuggestedStop(${c.lat}, ${c.lng}, 'Point ${idx}')" class="btn btn-sm btn-success mt-2">✅ Créer cet arrêt</button>`;
        const marker = L.marker([c.lat, c.lng], { icon }).bindPopup(popupContent);
        marker.addTo(map);
        currentMarkers.suggested.push(marker);
        }
        if (currentMarkers.suggested.length > 0) {
        document.getElementById('infoPanel').innerHTML = `<div class="alert alert-success">✅ ${currentMarkers.suggested.length} points suggérés. Cliquez sur un marqueur violet pour créer l'arrêt.</div>`;
        } else {
        document.getElementById('infoPanel').innerHTML = '<div class="alert alert-info">ℹ️ Tous les points suggérés existent déjà.</div>';
        }
        } else {
        document.getElementById('infoPanel').innerHTML = '<div class="alert alert-warning">Aucun point suggéré.</div>';
        }
        }

        window.createSuggestedStop = async (lat, lng, defaultName) => {
        const name = prompt("Nom du point de ramassage:", defaultName);
        if (!name) return;
        try {
        const response = await fetch('/Clustering/CreateStopForTrajectory', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trajectoryId: DEFAULT_TRAJECTORY_ID, name: name, latitude: lat, longitude: lng })
        });
        if (response.ok) {
        showNotification("✅ Point créé avec succès !");
        await loadExistingStops();
        } else {
        const error = await response.json();
        showNotification("❌ " + (error.message || "Erreur lors de la création."), true);
        }
        } catch (err) {
        showNotification("❌ Erreur réseau.", true);
        }
        };

        async function addManualStop() {
        const name = document.getElementById('stopName').value;
        const lat = document.getElementById('stopLat').value;
        const lng = document.getElementById('stopLng').value;
        if (!name) {
        showNotification("Entrez un nom pour le point.", true);
        return;
        }
        if (!lat || !lng) {
        showNotification("Cliquez d'abord sur la carte pour placer le point.", true);
        return;
        }
        try {
        const response = await fetch('/Clustering/CreateStopForTrajectory', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
        trajectoryId: DEFAULT_TRAJECTORY_ID,
        name: name,
        latitude: parseFloat(lat),
        longitude: parseFloat(lng)
        })
        });
        const result = await response.json();
        if (response.ok && result.success) {
        showNotification("✅ Point ajouté manuellement !");
        document.getElementById('stopName').value = '';
        document.getElementById('stopLat').value = '';
        document.getElementById('stopLng').value = '';
        await loadExistingStops();
        } else {
        showNotification("❌ " + (result.message || "Erreur lors de l'ajout."), true);
        }
        } catch (err) {
        showNotification("❌ Erreur réseau.", true);
        }
        }

        function initMap() {
        if (!map) {
        map = L.map('map').setView([KENITRA_CENTER_LAT, KENITRA_CENTER_LNG], 12);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OSM & CartoDB'
        }).addTo(map);
        addSEWSMarker();
        setTimeout(() => map.invalidateSize(), 500);
        }
        }

        document.getElementById('btnAddStop').addEventListener('click', addManualStop);
        document.getElementById('btnCompute').addEventListener('click', loadPickupPoints);
        document.getElementById('autoAssignAllBtn').addEventListener('click', autoAssignAll);
        document.getElementById('confirmAssignBtn').addEventListener('click', confirmAssign);
        document.getElementById('autoAssignToStopBtn').addEventListener('click', autoAssignToStop);
        document.getElementById('saveStopChanges').addEventListener('click', saveStopChanges);
        document.getElementById('refreshTableBtn').addEventListener('click', loadExistingStops);
        document.getElementById('refreshFilterBtn').addEventListener('click', () => loadExistingStops());
        document.getElementById('trajectoryFilter').addEventListener('change', () => loadExistingStops());

        initMap();
        loadTrajectoriesFilter();
    </script>
}