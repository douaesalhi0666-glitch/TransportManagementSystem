        }
        }
        };

        window.openAssignModal = async function(stopId, stopName) {
        document.getElementById('assignStopId').value = stopId;
        document.getElementById('assignStopNameDisplay').value = stopName;
        document.getElementById('assignStopNameHidden').value = stopName;
        const workerSelect = document.getElementById('workerSelect');
        workerSelect.innerHTML = '<option value="">-- Chargement... --</option>';
        try {
        const response = await fetch('/Clustering/GetUnassignedWorkers');
        const workers = await response.json();
        if (workers.length > 0) {
        workerSelect.innerHTML = '<option value="">-- Sélectionner un personnel --</option>';
        workers.forEach(w => {
        workerSelect.innerHTML += `<option value="${w.personnel_Id}">${w.personnel_FirstName} ${w.personnel_LastName} - ${w.homeAddress || 'Adresse inconnue'}</option>`;
        });
        } else {
        workerSelect.innerHTML = '<option value="">Aucun personnel non assigné disponible</option>';
        }
        } catch (err) {
        workerSelect.innerHTML = '<option value="">Erreur de chargement</option>';
        }
        new bootstrap.Modal(document.getElementById('assignWorkerModal')).show();
        };

