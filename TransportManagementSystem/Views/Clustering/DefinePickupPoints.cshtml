        async function saveStopChanges() {
        const id = document.getElementById('editStopId').value;
        const name = document.getElementById('editStopName').value;
        const lat = parseFloat(document.getElementById('editStopLat').value);
        const lng = parseFloat(document.getElementById('editStopLng').value);
        const order = parseInt(document.getElementById('editStopOrder').value);
        if (!name || isNaN(lat) || isNaN(lng) || isNaN(order)) {
        showNotification('Veuillez remplir tous les champs correctement.', true);
        return;
        }
        try {
        const response = await fetch('/Clustering/UpdateStop', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(id), name: name, latitude: lat, longitude: lng, orderIndex: order })
        });
        if (response.ok) {
        showNotification('Arrêt modifié avec succès !');
        bootstrap.Modal.getInstance(document.getElementById('editStopModal')).hide();
        await loadExistingStops();
        } else {
        showNotification('Erreur lors de la modification.', true);
        }
        } catch (err) {
        showNotification('Erreur réseau.', true);
        }
        }

        function clearSuggestedMarkers() {
        if (currentMarkers.suggested) currentMarkers.suggested.forEach(m => map.removeLayer(m));
        currentMarkers.suggested = [];
        }

        function addSEWSMarker() {
        const sewsIcon = L.divIcon({ html: '🏭', iconSize: [40, 40], className: 'sews-marker' });
        const marker = L.marker([SEWS_LAT, SEWS_LNG], { icon: sewsIcon })
        .bindPopup('<strong>SEWS Maroc</strong><br>Point de départ');
        marker.addTo(map);
        currentMarkers.sews.push(marker);
        }

        async function loadPickupPoints() {
        const k = document.getElementById('kValue').value;
        const response = await fetch('/Clustering/SuggestPickupPoints', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trajectoryId: DEFAULT_TRAJECTORY_ID, numberOfClusters: parseInt(k) })
        });
        const data = await response.json();
        clearSuggestedMarkers();
        if (data.clusters && data.clusters.length > 0) {
        for (const c of data.clusters) {
        let alreadyExists = false;
        if (currentMarkers.existing) {
        for (const marker of currentMarkers.existing) {
        const latLng = marker.getLatLng();
        const distance = Math.sqrt(Math.pow(latLng.lat - c.lat, 2) + Math.pow(latLng.lng - c.lng, 2));
        if (distance < 0.001) { alreadyExists = true; break; }
        }
        }
        if (alreadyExists || c.exists) continue;
        const idx = currentMarkers.suggested.length + 1;
        const icon = L.divIcon({ html: idx.toString(), iconSize: [28, 28], className: 'suggested-marker' });
        let popupContent = `<strong>Point suggéré ${idx}</strong><br>${c.count} personnes proches<br>`;
        popupContent += `<button onclick="createSuggestedStop(${c.lat}, ${c.lng}, 'Point ${idx}')" class="btn btn-sm btn-success mt-2">Créer cet arrêt</button>`;
        const marker = L.marker([c.lat, c.lng], { icon }).bindPopup(popupContent);
        marker.addTo(map);
        currentMarkers.suggested.push(marker);
        }
        if (currentMarkers.suggested.length > 0) {
        document.getElementById('infoPanel').innerHTML = `<div class="alert alert-success">${currentMarkers.suggested.length} points suggérés. Cliquez sur un marqueur violet pour créer l'arrêt.</div>`;
        } else {
        document.getElementById('infoPanel').innerHTML = '<div class="alert alert-info">Tous les points suggérés existent déjà.</div>';
        }
        } else {
        document.getElementById('infoPanel').innerHTML = '<div class="alert alert-warning">Aucun point suggéré.</div>';
        }
        }

        window.createSuggestedStop = async (lat, lng, defaultName) => {
        const name = prompt("Nom du point de ramassage:", defaultName);
        if (!name) return;
        try {
        const response = await fetch('/Clustering/CreateStopForTrajectory', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trajectoryId: DEFAULT_TRAJECTORY_ID, name: name, latitude: lat, longitude: lng })
        });
        if (response.ok) {
        showNotification("Point créé avec succès !");
        await loadExistingStops();
        } else {
        const error = await response.json();
        showNotification("Erreur lors de la création.", true);
        }
        } catch (err) {
        showNotification("Erreur réseau.", true);
        }
        };

        async function addManualStop() {
        const name = document.getElementById('stopName').value;
        const lat = document.getElementById('stopLat').value;
        const lng = document.getElementById('stopLng').value;
        if (!name) {
        showNotification("Entrez un nom pour le point.", true);
        return;
        }
        if (!lat || !lng) {
        showNotification("Cliquez d'abord sur la carte pour placer le point.", true);
        return;
        }
        try {
        const response = await fetch('/Clustering/CreateStopForTrajectory', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
        trajectoryId: DEFAULT_TRAJECTORY_ID,
        name: name,
        latitude: parseFloat(lat),
        longitude: parseFloat(lng)
        })
        });
        const result = await response.json();
        if (response.ok && result.success) {
        showNotification("Point ajouté manuellement !");
        document.getElementById('stopName').value = '';
        document.getElementById('stopLat').value = '';
        document.getElementById('stopLng').value = '';
        await loadExistingStops();
        } else {
        showNotification("Erreur lors de l'ajout.", true);
        }
        } catch (err) {
        showNotification("Erreur réseau.", true);
        }
        }

        function initMap() {
        if (!map) {
        map = L.map('map').setView([KENITRA_CENTER_LAT, KENITRA_CENTER_LNG], 12);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OSM & CartoDB'
        }).addTo(map);
        addSEWSMarker();
        setTimeout(() => map.invalidateSize(), 500);
        }
        }

        document.getElementById('btnAddStop').addEventListener('click', addManualStop);
        document.getElementById('btnCompute').addEventListener('click', loadPickupPoints);
        document.getElementById('autoAssignAllBtn').addEventListener('click', autoAssignAll);
        document.getElementById('confirmAssignBtn').addEventListener('click', confirmAssign);
        document.getElementById('autoAssignToStopBtn').addEventListener('click', autoAssignToStop);
        document.getElementById('saveStopChanges').addEventListener('click', saveStopChanges);
        document.getElementById('refreshTableBtn').addEventListener('click', loadExistingStops);
        document.getElementById('refreshFilterBtn').addEventListener('click', () => loadExistingStops());
        document.getElementById('trajectoryFilter').addEventListener('change', () => loadExistingStops());

        initMap();
        loadTrajectoriesFilter();
    </script>
}