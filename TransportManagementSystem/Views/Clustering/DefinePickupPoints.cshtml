        window.deleteStop = async function(id, name) {
        if (confirm(`Supprimer le point "${name}" ?`)) {
        try {
        const response = await fetch(`/Clustering/DeleteStop?id=${id}`, { method: 'DELETE' });
        if (response.ok) {
        showNotification(`Point "${name}" supprimé !`);
        await loadExistingStops();
        } else {
        const errorData = await response.json();
        showNotification("Erreur lors de la suppression.", true);
        }
        } catch (err) {
