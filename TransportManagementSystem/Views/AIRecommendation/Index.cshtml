@model List<TransportManagementSystem.Services.AssignmentRecommendation>

@{
    ViewData["Title"] = "Recommandations IA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>🤖 Optimisation intelligente des tournées</h1>
<p class="text-muted">Recommandations basées sur l'analyse des conducteurs, bus et trajectoires</p>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        ✅ @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        ❌ @TempData["Error"]
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        ℹ️ Aucune recommandation disponible pour le moment. Assurez-vous d'avoir des conducteurs disponibles, des bus en service et des trajectoires actives.
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>📊 Meilleures affectations recommandées</h4>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Score</th>
                                <th>Conducteur</th>
                                <th>Expérience</th>
                                <th>Bus</th>
                                <th>Capacité</th>
                                <th>Trajet</th>
                                <th>Personnel assigné</th>
                                <th>Raison</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rec in Model)
                            {
                                string rowColor = rec.Score >= 80 ? "#e8f5e9" : rec.Score >= 60 ? "#fff3e0" : "#ffebee";
                                <tr style="background-color: @rowColor">
                                    <td>
                                        <div class="progress" style="width: 80px;">
                                            <div class="progress-bar @(rec.Score >= 80 ? "bg-success" : rec.Score >= 60 ? "bg-warning" : "bg-danger")" role="progressbar" style="width: @rec.Score%">
                                                @rec.Score%
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <strong>@(rec.Driver?.Driver_FirstName ?? "N/A") @(rec.Driver?.Driver_LastName ?? "")</strong><br />
                                        <small class="text-muted">ID: @(rec.Driver?.Driver_id.ToString() ?? "N/A")</small>
                                    </td>
                                    <td>@((rec.Driver?.Driver_ExperienceYears ?? 0).ToString()) ans</td>
                                    <td>
                                        <strong>@(rec.Bus?.Bus_Code ?? "N/A")</strong><br />
                                        <small>@(rec.Bus?.Bus_PlateNumber ?? "N/A")</small>
                                    </td>
                                    <td>@((rec.Bus?.Bus_Capacity ?? 50).ToString()) places</td>
                                    <td>
                                        <strong>@(rec.Trajectory?.Trajectory_Name ?? "N/A")</strong><br />
                                        <small>@(rec.Trajectory?.Trajectory_Code ?? "N/A")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@rec.RequiredCapacity personnes</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@rec.Reason</small>
                                    </td>
                                    <td>
                                        <form method="post" asp-action="ApplyRecommendation">
                                            <input type="hidden" name="driverId" value="@(rec.Driver?.Driver_id ?? 0)" />
                                            <input type="hidden" name="busId" value="@(rec.Bus?.Bus_Id ?? 0)" />
                                            <input type="hidden" name="trajectoryId" value="@(rec.Trajectory?.Trajectory_Id ?? 0)" />
                                            <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Appliquer cette recommandation ?')">
                                                ✅ Appliquer
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h4>ℹ️ Comment fonctionne l'optimisation IA ?</h4>
            </div>
            <div class="card-body">
                <ul>
                    <li><strong>Score élevé (vert)</strong> → Excellente correspondance, recommandée</li>
                    <li><strong>Score moyen (orange)</strong> → Correspondance acceptable</li>
                    <li><strong>Score bas (rouge)</strong> → Correspondance à éviter</li>
                </ul>
                <p class="mb-0">Le système analyse :</p>
                <ol>
                    <li>L'expérience du conducteur</li>
                    <li>La capacité du bus vs le nombre de personnels</li>
                    <li>L'historique de ponctualité du conducteur sur ce trajet</li>
                    <li>La disponibilité des conducteurs et des bus</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<a href="/Dashboard/AdminDashboard" class="btn btn-secondary mt-3">Retour au Dashboard</a>