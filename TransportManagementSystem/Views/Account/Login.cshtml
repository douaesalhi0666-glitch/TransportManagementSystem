@{
    ViewData["Title"] = "Connexion";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion — TransportMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
            :root {
                --navy: #0f1c2e;
                --navy-mid: #162436;
                --navy-light: #1e3250;
                --navy-border: #263d5a;
                --amber: #f5a623;
                --text-main: #e8edf5;
                --text-muted: #8da0b8;
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
            }

            body {
                min-height: 100vh;
                display: flex;
                font-family: 'DM Sans', sans-serif;
                background: var(--navy);
                overflow: hidden;
                position: relative;
            }

            .login-left {
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: flex-start;
                padding: 60px 64px;
                background: var(--navy-mid);
                position: relative;
                overflow: hidden;
            }

                .login-left::before {
                    content: '';
                    position: absolute;
                    width: 420px;
                    height: 420px;
                    border-radius: 50%;
                    border: 60px solid rgba(245,166,35,0.07);
                    top: -100px;
                    left: -120px;
                    pointer-events: none;
                }

                .login-left::after {
                    content: '';
                    position: absolute;
                    width: 280px;
                    height: 280px;
                    border-radius: 50%;
                    background: radial-gradient(circle, rgba(245,166,35,0.06) 0%, transparent 70%);
                    bottom: 60px;
                    right: 40px;
                    pointer-events: none;
                }

            .brand-mark {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 64px;
                position: relative;
                z-index: 1;
            }

            .brand-icon {
                width: 48px;
                height: 48px;
                background: var(--amber);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.3rem;
                color: var(--navy);
                font-weight: 800;
            }

            .brand-name {
                font-family: 'Sora', sans-serif;
                font-size: 1.25rem;
                font-weight: 700;
                color: var(--text-main);
            }

                .brand-name span {
                    color: var(--amber);
                }

            .hero-tagline {
                font-family: 'Sora', sans-serif;
                font-size: 2.4rem;
                font-weight: 800;
                color: var(--text-main);
                line-height: 1.2;
                margin-bottom: 18px;
                position: relative;
                z-index: 1;
            }

                .hero-tagline em {
                    color: var(--amber);
                    font-style: normal;
                }

            .hero-sub {
                font-size: 0.95rem;
                color: var(--text-muted);
                line-height: 1.7;
                max-width: 360px;
                position: relative;
                z-index: 1;
            }

            .stats-row {
                display: flex;
                gap: 32px;
                margin-top: 56px;
                position: relative;
                z-index: 1;
            }

            .stat-num {
                font-family: 'Sora', sans-serif;
                font-size: 1.6rem;
                font-weight: 700;
                color: var(--amber);
            }

            .stat-label {
                font-size: 0.72rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: var(--text-muted);
                margin-top: 2px;
            }

            .route-lines {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: repeating-linear-gradient(90deg, var(--amber) 0px, var(--amber) 24px, transparent 24px, transparent 40px);
                opacity: 0.25;
            }

            .login-right {
                width: 440px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 48px 40px;
                background: #fff;
            }

            .login-form-wrap {
                width: 100%;
                max-width: 360px;
                text-align: center;
            }

            /* Logo au-dessus de Bienvenue - PLUS HAUT */
            .login-logo {
                margin-bottom: 0;
                text-align: center;
                margin-top: -60px;
            }

                .login-logo img {
                    height: 150px;
                    width: auto;
                }

            .form-title {
                font-family: 'Sora', sans-serif;
                font-size: 1.5rem;
                font-weight: 700;
                color: #0f172a;
                margin-bottom: 6px;
            }

            .form-subtitle {
                font-size: 0.85rem;
                color: #64748b;
                margin-bottom: 32px;
            }

            .form-label {
                font-size: 0.78rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: #374151;
                margin-bottom: 6px;
                text-align: left;
                display: block;
            }

            .form-control {
                border: 1.5px solid #e2e8f0;
                border-radius: 10px;
                padding: 12px 14px 12px 42px;
                font-size: 0.9rem;
                font-family: 'DM Sans', sans-serif;
                color: #0f172a;
                background: #f8fafc;
                transition: border-color 0.15s, box-shadow 0.15s;
                width: 100%;
            }

                .form-control:focus {
                    border-color: var(--amber);
                    box-shadow: 0 0 0 3px rgba(245,166,35,0.15);
                    background: #fff;
                    outline: none;
                }

            .input-wrap {
                position: relative;
                text-align: left;
            }

            .input-icon {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 0.85rem;
                pointer-events: none;
            }

            .btn-login {
                width: 100%;
                padding: 13px;
                background: var(--navy);
                color: #fff;
                border: none;
                border-radius: 10px;
                font-family: 'Sora', sans-serif;
                font-weight: 600;
                font-size: 0.9rem;
                cursor: pointer;
                transition: background 0.2s, transform 0.1s;
                margin-top: 8px;
            }

                .btn-login:hover {
                    background: var(--navy-light);
                }

                .btn-login:active {
                    transform: scale(0.98);
                }

            .err-box {
                background: #fef2f2;
                border: 1px solid #fecaca;
                color: #dc2626;
                border-radius: 10px;
                font-size: 0.85rem;
                padding: 12px 14px;
                margin-bottom: 20px;
                text-align: left;
            }

            #passwordGroup {
                overflow: hidden;
                transition: max-height 0.3s ease, opacity 0.3s ease;
                max-height: 0;
                opacity: 0;
            }

                #passwordGroup.visible {
                    max-height: 120px;
                    opacity: 1;
                }

            @@media (max-width: 768px) {
                body {
                    flex-direction: column;
                    overflow: auto;
                }

                .login-left {
                    padding: 40px 28px 48px;
                    flex: none;
                    min-height: 240px;
                }

                .hero-tagline {
                    font-size: 1.7rem;
                }

                .stats-row {
                    gap: 20px;
                }

                .login-right {
                    width: 100%;
                    padding: 36px 24px 48px;
                }

                .login-logo {
                    margin-top: -30px;
                }

                    .login-logo img {
                        height: 100px;
                    }
            }
    </style>
</head>
<body>

    <div class="login-left">
        <div class="brand-mark">
            <div class="brand-icon"><i class="fas fa-bus-alt"></i></div>
            <div class="brand-name"><span>Transport</span>MS</div>
        </div>
        <h1 class="hero-tagline">Gérez votre<br>flotte avec<br><em>précision</em>.</h1>
        <p class="hero-sub">Plateforme centralisée de gestion des transports — personnel, chauffeurs, bus, trajets et anomalies, en un seul endroit.</p>
        <div class="stats-row">
            <div><div class="stat-num">100%</div><div class="stat-label">Couverture</div></div>
            <div><div class="stat-num">Temps réel</div><div class="stat-label">Détection</div></div>
            <div><div class="stat-num">IA</div><div class="stat-label">Intégrée</div></div>
        </div>
        <div class="route-lines"></div>
    </div>

    <div class="login-right">
        <div class="login-form-wrap">
            <!-- SEWS Logo - TRÈS GRAND ET PLUS HAUT -->
            <div class="login-logo">
                <img src="~/images/sews_logo.png" alt="SEWS" />
            </div>

            <h2 class="form-title">Bienvenue</h2>
            <p class="form-subtitle">Connectez-vous pour accéder à votre espace.</p>

            @if (ViewBag.Error != null)
            {
                <div class="err-box"><i class="fas fa-circle-exclamation me-2"></i>@ViewBag.Error</div>
            }

            <form method="post">
                <div class="mb-4">
                    <label class="form-label" for="email">Adresse e-mail</label>
                    <div class="input-wrap">
                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email" name="email" id="email" class="form-control" placeholder="exemple@sews.ma" required />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="id">Identifiant (ID)</label>
                    <div class="input-wrap">
                        <i class="fas fa-id-badge input-icon"></i>
                        <input type="number" name="id" id="id" class="form-control" placeholder="Votre ID numérique" required />
                    </div>
                </div>
                <div id="passwordGroup" class="mb-4">
                    <label class="form-label" for="password">Mot de passe</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" name="password" id="password" class="form-control" placeholder="••••••••" />
                    </div>
                    <small style="font-size:0.72rem;color:#94a3b8;margin-top:5px;display:block;">Requis uniquement pour l'administrateur.</small>
                </div>
                <button type="submit" class="btn-login">
                    <i class="fas fa-right-to-bracket me-2"></i>Se connecter
                </button>
            </form>
        </div>
    </div>

    <script>
            const emailInput = document.getElementById('email');
            const idInput    = document.getElementById('id');
            const pwGroup    = document.getElementById('passwordGroup');
            const pwInput    = document.getElementById('password');

            function togglePassword() {
                const isAdmin = emailInput.value === 'admin@sews.ma' && idInput.value === '1';
                if (isAdmin) { pwGroup.classList.add('visible'); pwInput.required = true; }
                else { pwGroup.classList.remove('visible'); pwInput.required = false; pwInput.value = ''; }
            }
            emailInput.addEventListener('input', togglePassword);
            idInput.addEventListener('input', togglePassword);
    </script>
</body>
</html>