@{
    ViewData["Title"] = "Créer votre mot de passe";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Créer votre mot de passe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .reset-card {
                background: white;
                border-radius: 20px;
                padding: 40px;
                width: 100%;
                max-width: 450px;
            }

            .btn-primary {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border: none;
            }
    </style>
</head>
<body>
    <div class="reset-card">
        <h2 class="text-center">🔐 Créer votre mot de passe</h2>
        <p class="text-muted text-center">Veuillez choisir un mot de passe sécurisé</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center">@ViewBag.Error</div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success text-center">
                <p>@ViewBag.Success</p>
                <hr />
                <a href="/Account/Login" class="btn btn-primary">Se connecter</a>
            </div>
        }

        @if (ViewBag.Success == null)
        {
            <form method="post">
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <input type="hidden" name="email" value="@ViewBag.Email" />
                <input type="hidden" name="role" value="@ViewBag.Role" />

                <div class="mb-3">
                    <label>Nouveau mot de passe</label>
                    <input type="password" name="newPassword" class="form-control" required minlength="6" />
                    <small class="text-muted">Minimum 6 caractères</small>
                </div>
                <div class="mb-3">
                    <label>Confirmer le mot de passe</label>
                    <input type="password" name="confirmPassword" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Enregistrer</button>
            </form>
        }
    </div>
</body>
</html>