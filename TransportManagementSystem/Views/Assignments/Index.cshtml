@{
    ViewData["Title"] = "Assignations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>🔗 Gestion des Assignations</h1>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">✅ @TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">❌ @TempData["Error"]</div>
}

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4>🚛 Assigner un chauffeur à un bus</h4>
            </div>
            <div class="card-body">
                <form method="post" action="/Assignments/AssignDriverToBus">
                    <div class="mb-3">
                        <label>Chauffeur</label>
                        <select name="driverId" class="form-control" required>
                            <option value="">-- Sélectionner un chauffeur --</option>
                            @foreach (var driver in ViewBag.Drivers)
                            {
                                if (driver.Driver_AssignedBusId == null)
                                {
                                    <option value="@driver.Driver_id">@driver.Driver_FirstName @driver.Driver_LastName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Bus</label>
                        <select name="busId" class="form-control" required>
                            <option value="">-- Sélectionner un bus --</option>
                            @foreach (var bus in ViewBag.Buses)
                            {
                                if (bus.Bus_CurrentDriverId == null)
                                {
                                    <option value="@bus.Bus_Id">@bus.Bus_Code - @bus.Bus_PlateNumber</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Assigner</button>
                </form>
            </div>
        </div>
    </div>
</div>

<hr />
<h3>📋 Assignations actuelles (Chauffeur ↔ Bus)</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Bus</th>
            <th>Plaque</th>
            <th>Chauffeur</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bus in ViewBag.Buses)
        {
            <tr>
                <td>@bus.Bus_Code</td>
                <td>@bus.Bus_PlateNumber</td>
                <td>
                    @if (bus.CurrentDriver != null)
                    {
                        @bus.CurrentDriver.Driver_FirstName @bus.CurrentDriver.Driver_LastName
                    }
                    else
                    {
                        <span class="text-muted">Non assigné</span>
                    }
                </td>
                <td>
                    @if (bus.CurrentDriver != null)
                    {
                        <form method="post" action="/Assignments/UnassignDriver" style="display:inline;">
                            <input type="hidden" name="driverId" value="@bus.CurrentDriver.Driver_id" />
                            <button type="submit" class="btn btn-sm btn-danger">Libérer chauffeur</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/Dashboard/AdminDashboard" class="btn btn-secondary">Retour au Dashboard</a>