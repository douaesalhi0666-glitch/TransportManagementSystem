@model List<TransportManagementSystem.Models.Personnel>

@{
    ViewData["Title"] = "Assigner le personnel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>🎫 Assigner le personnel à un trajet / bus</h1>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">❌ @TempData["Error"]</div>
}

<div class="row">
    <!-- Colonne gauche : Formulaire d'assignation -->
    <div class="col-md-5">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5>Assigner un personnel</h5>
            </div>
            <div class="card-body">
                <!-- Sélection du personnel -->
                <div class="mb-3">
                    <label for="personnelSelect" class="form-label">Personnel non assigné</label>
                    <select id="personnelSelect" class="form-select">
                        <option value="">-- Sélectionner --</option>
                        @foreach (var p in ViewBag.Personnel)
                        {
                            <option value="@p.Personnel_Id" data-lat="@p.Personnel_Latitude" data-lng="@p.Personnel_Longitude">
                                @p.Personnel_FirstName @p.Personnel_LastName (ID: @p.Personnel_Id)
                            </option>
                        }
                    </select>
                </div>

                <!-- Sélection du trajet -->
                <div class="mb-3">
                    <label for="trajectorySelect" class="form-label">Trajet (manuel)</label>
                    <select id="trajectorySelect" class="form-select">
                        <option value="">-- Choisir un trajet --</option>
                        @foreach (var t in ViewBag.Trajectories)
                        {
                            <option value="@t.Trajectory_Id">@t.Trajectory_Name (@t.Trajectory_Code)</option>
                        }
                    </select>
                </div>

                <div class="d-grid gap-2">
                    <button id="btnAssignManual" class="btn btn-primary">📌 Assigner manuellement</button>
                    <button id="btnAssignAI" class="btn btn-success">🤖 Assigner par IA (plus proche trajet)</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Colonne droite : Listes des assignations actuelles -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5>📋 Assignations actuelles (personnel → trajet / bus)</h5>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID Personnel</th>
                                <th>Nom</th>
                                <th>Trajet assigné</th>
                                <th>Bus assigné</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>@p.Personnel_Id</td>
                                    <td>@p.Personnel_FirstName @p.Personnel_LastName</td>
                                    <td>@p.AssignedTrajectory?.Trajectory_Name ?? "Non défini"</td>
                                    <td>@p.AssignedBus?.Bus_Code ?? "Non défini"</td>
                                    <td>
                                        <form method="post" asp-action="UnassignPersonnel" style="display:inline;">
                                            <input type="hidden" name="personnelId" value="@p.Personnel_Id" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Désassigner ce personnel ?')">
                                                ❌ Désassigner
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">Aucun personnel assigné pour le moment.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnAssignManual').addEventListener('click', function() {
            var personnelId = document.getElementById('personnelSelect').value;
            var trajectoryId = document.getElementById('trajectorySelect').value;
            if (!personnelId || !trajectoryId) {
                alert("Veuillez sélectionner un personnel et un trajet.");
                return;
            }
            var form = document.createElement('form');
            form.method = 'post';
            form.action = '@Url.Action("AssignPersonnelManual")';
            form.style.display = 'none';
            form.innerHTML = '<input type="hidden" name="personnelId" value="' + personnelId + '">' +
                             '<input type="hidden" name="trajectoryId" value="' + trajectoryId + '">';
            document.body.appendChild(form);
            form.submit();
        });

        document.getElementById('btnAssignAI').addEventListener('click', function() {
            var personnelId = document.getElementById('personnelSelect').value;
            if (!personnelId) {
                alert("Veuillez sélectionner un personnel.");
                return;
            }
            var form = document.createElement('form');
            form.method = 'post';
            form.action = '@Url.Action("AssignPersonnelAI")';
            form.style.display = 'none';
            form.innerHTML = '<input type="hidden" name="personnelId" value="' + personnelId + '">';
            document.body.appendChild(form);
            form.submit();
        });
    </script>
}