@model IEnumerable<TransportManagementSystem.ViewModels.BusOccupancyViewModel>

@{
    ViewData["Title"] = "Occupation des bus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>🚌 Gestion des bus</h1>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        ✅ @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        ❌ @TempData["Error"]
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <form method="post" asp-action="SyncPersonnelBusAssignments" asp-controller="TrajectoryAssignment" class="d-inline">
            <button type="submit" class="btn btn-warning">🔄 Synchroniser les assignations (Stop → Bus)</button>
        </form>
    </div>
    <div class="col-md-6 text-end">
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#assignBusModal">
            ➕ Assigner un bus à une trajectoire
        </button>
    </div>
</div>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        if (item.Bus == null) continue;

        var capacity = item.Capacity > 0 ? item.Capacity : 1;
        var percentage = (item.Occupancy * 100) / capacity;
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">🚌 Bus @item.Bus.Bus_Code - @item.Bus.Bus_PlateNumber</h4>
                    <div>
                        <button class="btn btn-sm btn-danger" onclick="unassignBus(@item.Bus.Bus_Id, '@item.Bus.Bus_Code')">
                            🔓 Désassigner du trajet
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Chauffeur:</strong> @(item.Bus.CurrentDriver?.Driver_FirstName ?? "Non assigné") @(item.Bus.CurrentDriver?.Driver_LastName ?? "")</p>
                        <p><strong>Trajectoire:</strong> @(item.Bus.CurrentTrajectory?.Trajectory_Name ?? "Non définie")</p>
                        <p><strong>Capacité:</strong> @capacity places</p>
                        <p><strong>Occupation actuelle:</strong> @item.Occupancy / @capacity</p>
                        <div class="progress mb-3">
                            <div class="progress-bar @(percentage > 90 ? "bg-danger" : percentage > 70 ? "bg-warning" : "bg-success")" role="progressbar" style="width: @percentage%">
                                @percentage%
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.Bus.Bus_Id">
                            📋 Voir les personnels assignés
                        </button>
                        <button type="button" class="btn btn-sm btn-success ms-2" onclick="showUnassignedPersonnel(@item.Bus.Bus_Id, '@item.Bus.Bus_Code')">
                            👥 Assigner des personnels
                        </button>
                    </div>
                </div>

                <div class="collapse mt-3" id="collapse-@item.Bus.Bus_Id">
                    <div class="card card-body">
                        <h5>👥 Personnels assignés à ce bus</h5>
                        @if (item.Personnel != null && item.Personnel.Count > 0)
                        {
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Nom</th>
                                        <th>Prénom</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in item.Personnel)
                                    {
                                        <tr>
                                            <td>@p.Personnel_Id</td>
                                            <td>@p.Personnel_LastName</td>
                                            <td>@p.Personnel_FirstName</td>
                                            <td>
                                                <form method="post" asp-action="RemovePersonnelFromBus" asp-controller="TrajectoryAssignment" style="display:inline;">
                                                    <input type="hidden" name="personnelId" value="@p.Personnel_Id" />
                                                    <input type="hidden" name="busId" value="@item.Bus.Bus_Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Retirer ce personnel du bus ?')">
                                                        ❌ Désassigner
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">Aucun personnel assigné à ce bus.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        ℹ️ Aucun bus disponible ou aucune assignation.
    </div>
}

<!-- Modal pour assigner un bus à une trajectoire spécifique -->
<div class="modal fade" id="assignBusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">🚌 Assigner un bus à une trajectoire</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label>Sélectionner un bus</label>
                    <select id="busSelect" class="form-control" required>
                        <option value="">-- Chargement des bus --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label>Sélectionner une trajectoire</label>
                    <select id="trajectorySelect" class="form-control" required>
                        <option value="">-- Chargement des trajectoires --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="confirmAssignBusBtn">Assigner</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal pour assigner un personnel manuellement -->
<div class="modal fade" id="assignPersonnelModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">👥 Personnels non assignés</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalBusId" />
                <div id="unassignedPersonnelList">
                    <p class="text-center">Chargement...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<a href="/Dashboard/AdminDashboard" class="btn btn-secondary">Retour au Dashboard</a>

@section Scripts {
    <script>
        // Charger les bus disponibles (sans trajectoire)
        async function loadAvailableBuses() {
            const response = await fetch('/TrajectoryAssignment/GetAvailableBuses');
            const buses = await response.json();
            const select = document.getElementById('busSelect');
            select.innerHTML = '<option value="">-- Sélectionner un bus --</option>';
            buses.forEach(bus => {
                select.innerHTML += `<option value="${bus.bus_Id}">${bus.bus_Code} - ${bus.bus_PlateNumber}</option>`;
            });
        }

        // Charger les trajectoires actives (sans bus)
        async function loadAvailableTrajectories() {
            const response = await fetch('/TrajectoryAssignment/GetAvailableTrajectories');
            const trajectories = await response.json();
            const select = document.getElementById('trajectorySelect');
            select.innerHTML = '<option value="">-- Sélectionner une trajectoire --</option>';
            trajectories.forEach(traj => {
                select.innerHTML += `<option value="${traj.trajectory_Id}">${traj.trajectory_Name} (${traj.trajectory_Code})</option>`;
            });
        }

        // Assigner bus à trajectoire
        async function assignBusToTrajectory() {
            const busId = document.getElementById('busSelect').value;
            const trajectoryId = document.getElementById('trajectorySelect').value;

            if (!busId || !trajectoryId) {
                alert('Veuillez sélectionner un bus et une trajectoire');
                return;
            }

            const response = await fetch(`/TrajectoryAssignment/AssignBusToTrajectory?busId=${busId}&trajectoryId=${trajectoryId}`, {
                method: 'POST'
            });

            const result = await response.json();
            if (result.success) {
                alert('✅ ' + result.message);
                location.reload();
            } else {
                alert('❌ ' + result.message);
            }
        }

        // Désassigner bus de sa trajectoire
        window.unassignBus = async (busId, busCode) => {
            if (confirm(`Désassigner le bus ${busCode} de sa trajectoire ?`)) {
                const response = await fetch(`/TrajectoryAssignment/UnassignBus?busId=${busId}`, {
                    method: 'POST'
                });
                const result = await response.json();
                if (result.success) {
                    alert('✅ ' + result.message);
                    location.reload();
                } else {
                    alert('❌ ' + result.message);
                }
            }
        };

        // Ouvrir le modal et charger les personnels non assignés
        window.showUnassignedPersonnel = async (busId, busCode) => {
            document.getElementById('modalBusId').value = busId;
            const listDiv = document.getElementById('unassignedPersonnelList');
            listDiv.innerHTML = '<p class="text-center">Chargement des personnels disponibles...</p>';

            const response = await fetch(`/TrajectoryAssignment/GetUnassignedPersonnelForBus?busId=${busId}`);
            const personnel = await response.json();

            if (personnel && personnel.length > 0) {
                let html = '<div class="list-group">';
                personnel.forEach(p => {
                    html += `
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>${p.personnel_FirstName} ${p.personnel_LastName}</strong><br>
                                    <small class="text-muted">Arrêt: ${p.stopName}</small>
                                </div>
                                <button class="btn btn-sm btn-success" onclick="assignSpecificPersonnel(${busId}, ${p.personnel_Id})">
                                    ➕ Assigner
                                </button>
                            </div>
                        </div>
                    `;
                });
                html += '</div>';
                listDiv.innerHTML = html;
            } else {
                listDiv.innerHTML = '<div class="alert alert-info">Aucun personnel non assigné disponible pour ce bus.</div>';
            }

            new bootstrap.Modal(document.getElementById('assignPersonnelModal')).show();
        };

        // Assigner un personnel spécifique à un bus
        window.assignSpecificPersonnel = async (busId, personnelId) => {
            const response = await fetch(`/TrajectoryAssignment/AssignPersonnelToBus?busId=${busId}&personnelId=${personnelId}`, {
                method: 'POST'
            });
            const result = await response.json();
            if (result.success) {
                alert('✅ ' + result.message);
                location.reload();
            } else {
                alert('❌ ' + (result.message || 'Erreur lors de l\'assignation'));
            }
        };

        // Événements
        document.getElementById('confirmAssignBusBtn').onclick = assignBusToTrajectory;

        // Charger les données quand le modal s'ouvre
        document.getElementById('assignBusModal').addEventListener('show.bs.modal', function() {
            loadAvailableBuses();
            loadAvailableTrajectories();
        });
    </script>
}