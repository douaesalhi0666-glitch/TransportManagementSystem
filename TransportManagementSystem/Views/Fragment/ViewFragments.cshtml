@using TransportManagementSystem.Models
@model IEnumerable<TrajectoryFragment>

@{
    ViewData["Title"] = "Tous les fragments";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var busAssignments = ViewBag.BusAssignments as Dictionary<int, BusFragmentAssignment>;
}

<h1>📋 Liste des fragments de trajet</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">❌ @TempData["Error"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info">🔄 @TempData["Info"]</div>
}

<p>
    <a href="/Fragment/Index" class="btn btn-primary">➕ Générer de nouveaux fragments</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Aucun fragment enregistré pour le moment.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Nom du fragment</th>
                <th>Trajet</th>
                <th>Personnels</th>
                <th>Arrêts</th>
                <th>Bus assigné</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fragment in Model)
            {
                var stopCount = fragment.FragmentStops?.Count ?? 0;
                var hasAssignment = busAssignments != null && busAssignments.ContainsKey(fragment.Fragment_Id);
                var assignment = hasAssignment ? busAssignments[fragment.Fragment_Id] : null;
                
                <tr>
                    <td>@fragment.Fragment_Id</td>
                    <td>@fragment.Fragment_Code</td>
                    <td>@fragment.Fragment_Name</td>
                    <td>@(fragment.Trajectory?.Trajectory_Name ?? "N/A")</td>
                    <td>@fragment.Total_Workers</td>
                    <td>@stopCount</td>
                    <td>
                        @if (hasAssignment && assignment?.Bus != null)
                        {
                            <span>🚌 @assignment.Bus.Bus_Code (@assignment.Bus.Bus_PlateNumber)</span>
                            <br />
                            <small class="text-muted">Assigné le: @(assignment.Start_DateTime.ToString("dd/MM/yyyy HH:mm"))</small>
                        }
                        else
                        {
                            <span class="text-muted">Non assigné</span>
                        }
                    </td>
                    <td>
                        @if (hasAssignment && assignment?.Bus != null)
                        {
                            <a href="/Fragment/AssignBusToFragment?fragmentId=@fragment.Fragment_Id" class="btn btn-sm btn-warning">🔄 Changer bus</a>
                            <form method="post" asp-action="UnassignBusFromFragment" asp-route-fragmentId="@fragment.Fragment_Id"
                                  style="display:inline-block;"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir désassigner ce bus du fragment ?');">
                                <button type="submit" class="btn btn-sm btn-danger">❌ Désassigner</button>
                            </form>
                            <br />
                            <a href="/Fragment/FragmentMap?fragmentId=@fragment.Fragment_Id" class="btn btn-sm btn-info mt-1">🗺️ Voir sur carte</a>
                        }
                        else
                        {
                            <a href="/Fragment/AssignBusToFragment?fragmentId=@fragment.Fragment_Id" class="btn btn-sm btn-success">🚌 Assigner bus</a>
                            <br />
                            <a href="/Fragment/FragmentMap?fragmentId=@fragment.Fragment_Id" class="btn btn-sm btn-info mt-1">🗺️ Voir sur carte</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}