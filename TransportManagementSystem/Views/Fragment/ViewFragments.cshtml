@using TransportManagementSystem.Models
@model IEnumerable<TrajectoryFragment>

@{
    ViewData["Title"] = "Tous les fragments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>📋 Liste des fragments de trajet</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">❌ @TempData["Error"]</div>
}

<p>
    <a href="/Fragment/Index" class="btn btn-primary">➕ Générer de nouveaux fragments</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Aucun fragment enregistré pour le moment.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Nom du fragment</th>
                <th>Trajet</th>
                <th>Personnels</th>
                <th>Arrêts</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fragment in Model)
            {
                var stopCount = fragment.FragmentStops?.Count ?? 0;
                <tr>
                    <td>@fragment.Fragment_Id</td>
                    <td>@fragment.Fragment_Code</td>
                    <td>@fragment.Fragment_Name</td>
                    <td>@(fragment.Trajectory?.Trajectory_Name ?? "N/A")</td>
                    <td>@fragment.Total_Workers</td>
                    <td>@stopCount</td>
                    <td>
                        <a href="/Fragment/FragmentMap?fragmentId=@fragment.Fragment_Id" class="btn btn-sm btn-info">🗺️ Voir sur carte</a>
                        <a href="/Fragment/AssignBusToFragment?fragmentId=@fragment.Fragment_Id" class="btn btn-sm btn-success">🚌 Assigner bus</a>
                     </td>
                 </tr>
            }
        </tbody>
    </table>
}