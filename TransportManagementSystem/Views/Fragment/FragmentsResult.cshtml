@using TransportManagementSystem.Services
@model List<FragmentResult>

@{
    ViewData["Title"] = "Résultats des fragments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>🔍 Fragments générés</h1>
<p>Voici les fragments proposés pour la trajectoire sélectionnée.</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">
        ⚠️ Aucun fragment généré. Vérifiez que des personnels sont assignés aux arrêts.
    </div>
    <a href="/Fragment/Index" class="btn btn-secondary">Retour</a>
}
else
{
    <div class="alert alert-success">
        ✅ <strong>@Model.Count fragments</strong> ont été générés.
    </div>

    <form method="post" asp-action="SaveFragments">
        <input type="hidden" name="trajectoryId" value="@ViewBag.TrajectoryId" />
        <input type="hidden" name="fragmentsJson" id="fragmentsJson" />

        @foreach (var fragment in Model)
        {
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5>@fragment.FragmentName</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Code fragment :</strong> @fragment.FragmentCode</p>
                            <p><strong>Total personnels :</strong> @fragment.TotalWorkers</p>
                            <p><strong>Nombre d'arrêts :</strong> @fragment.Stops.Count</p>
                        </div>
                        <div class="col-md-6">
                            <h6>🚏 Arrêts inclus :</h6>
                            <ul>
                                @foreach (var stop in fragment.Stops)
                                {
                                    <li>@stop.StopName - @stop.WorkerCount personnes</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="mt-3">
            <button type="submit" class="btn btn-success">💾 Sauvegarder ces fragments</button>
            <a href="/Fragment/Index" class="btn btn-secondary">Annuler</a>
        </div>
    </form>
}

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function() {
            var fragments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
            document.getElementById('fragmentsJson').value = JSON.stringify(fragments);
        });
    </script>
}