@using TransportManagementSystem.Models
@{
    ViewData["Title"] = "Assigner un bus au fragment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fragment = ViewBag.Fragment as TrajectoryFragment;
    var availableBuses = ViewBag.AvailableBuses as IEnumerable<Bus>;
    var currentAssignment = ViewBag.CurrentAssignment as BusFragmentAssignment;
    var hasExistingAssignment = ViewBag.HasExistingAssignment == true;
}

<h1>🚌 Assigner un bus au fragment</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">❌ @TempData["Error"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info">🔄 @TempData["Info"]</div>
}

@if (hasExistingAssignment && currentAssignment?.Bus != null)
{
    <div class="alert alert-warning">
        <strong>⚠️ Bus actuellement assigné :</strong> @currentAssignment.Bus.Bus_Code (@currentAssignment.Bus.Bus_PlateNumber)
        <br />
        <small>En choisissant un nouveau bus, l'ancien sera automatiquement libéré et pourra être réassigné ailleurs.</small>
    </div>
}

@if (fragment == null)
{
    <div class="alert alert-danger">
        ❌ Fragment non trouvé. <a href="/Fragment/ViewFragments">Retour à la liste des fragments</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5>📌 Fragment sélectionné</h5>
                </div>
                <div class="card-body">
                    <p><strong>Code :</strong> @fragment.Fragment_Code</p>
                    <p><strong>Nom :</strong> @fragment.Fragment_Name</p>
                    <p><strong>Trajet :</strong> @(fragment.Trajectory?.Trajectory_Name ?? "Non spécifié")</p>
                    <p><strong>Personnels à transporter :</strong> @fragment.Total_Workers</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5>🚍 @(hasExistingAssignment ? "Changer le bus" : "Assigner un bus")</h5>
                </div>
                <div class="card-body">
                    @if (availableBuses != null && availableBuses.Any())
                    {
                        <form method="post">
                            <input type="hidden" name="fragmentId" value="@fragment.Fragment_Id" />
                            <div class="mb-3">
                                <label>@(hasExistingAssignment ? "Nouveau bus" : "Bus à assigner")</label>
                                <select name="busId" class="form-control" required>
                                    <option value="">-- Sélectionnez un bus --</option>
                                    @foreach (var bus in availableBuses)
                                    {
                                        var isCurrent = false;
                                        if (currentAssignment != null && currentAssignment.Bus_Id == bus.Bus_Id)
                                        {
                                            isCurrent = true;
                                        }
                                        if (isCurrent)
                                        {
                                            <option value="@bus.Bus_Id" selected="@isCurrent">@bus.Bus_Code (@bus.Bus_PlateNumber) - Capacité @(bus.Bus_Capacity ?? 50) places (actuellement assigné)</option>
                                        }
                                        else
                                        {
                                            <option value="@bus.Bus_Id">@bus.Bus_Code (@bus.Bus_PlateNumber) - Capacité @(bus.Bus_Capacity ?? 50) places</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label>Date et heure de départ</label>
                                @{
                                    var startDateTime = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
                                    if (currentAssignment != null && currentAssignment.Start_DateTime != null)
                                    {
                                        startDateTime = currentAssignment.Start_DateTime.ToString("yyyy-MM-ddTHH:mm");
                                    }
                                }
                                <input type="datetime-local" name="startTime" class="form-control" required value="@startDateTime" />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                @(hasExistingAssignment ? "🔄 Mettre à jour l'assignation" : "📅 Assigner ce bus")
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            ⚠️ Aucun bus disponible. Tous les bus sont déjà assignés à d'autres fragments ou sont hors service.
                        </div>
                        <a href="/Fragment/ViewFragments" class="btn btn-secondary w-100">Retour à la liste des fragments</a>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (fragment != null && availableBuses != null && availableBuses.Any())
{
    <a href="/Fragment/ViewFragments" class="btn btn-secondary mt-3">Retour à la liste des fragments</a>
}