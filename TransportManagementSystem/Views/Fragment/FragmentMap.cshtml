@{
    ViewData["Title"] = "Carte du fragment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fragmentData = ViewBag.FragmentData as dynamic;
}

<h1>🗺️ Visualisation du fragment</h1>

@if (fragmentData == null)
{
    <div class="alert alert-warning">Fragment introuvable.</div>
    <a href="/Fragment/ViewFragments" class="btn btn-secondary">Retour</a>
}
else
{
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5>@fragmentData.Fragment_Name (@fragmentData.Fragment_Code)</h5>
                </div>
                <div class="card-body">
                    <p><strong>Nombre total de personnels :</strong> @fragmentData.Total_Workers</p>
                    <p><strong>Arrêts dans ce fragment :</strong> @(((System.Collections.Generic.List<dynamic>)fragmentData.Stops).Count)</p>
                    @if (fragmentData.AssignedBus != null)
                    {
                        <p><strong>Bus assigné :</strong> @fragmentData.AssignedBus.Bus_Code (@fragmentData.AssignedBus.Bus_PlateNumber) - Statut : @fragmentData.BusStatus</p>
                    }
                    else
                    {
                        <p class="text-warning">⚠️ Aucun bus assigné pour le moment.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div id="map" style="height: 500px; width: 100%; border-radius: 10px;"></div>

    <div class="mt-3">
        <a href="/Fragment/ViewFragments" class="btn btn-secondary">Retour à la liste</a>
        <a href="/Fragment/AssignBusToFragment?fragmentId=@fragmentData.Fragment_Id" class="btn btn-success">🚌 Assigner un bus à ce fragment</a>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <style>
        .stop-marker { background-color: #28a745; color: white; border-radius: 50%; text-align: center; font-size: 12px; font-weight: bold; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border: 2px solid white; }
        .route-line { color: blue; }
    </style>

    @if (fragmentData != null)
    {
        var stops = fragmentData.Stops as System.Collections.Generic.List<dynamic>;
        if (stops != null && stops.Any())
        {
            <script>
                var map = L.map('map');
                L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> & CartoDB'
                }).addTo(map);

                var latLngs = [];
                @foreach (var stop in stops)
                {
                    var lat = stop.TS_Latitude;
                    var lng = stop.TS_Longitude;
                    var name = stop.TS_Name;
                    var order = stop.Stop_Order;
                    var workers = stop.Workers_At_Stop;
                    <text>
                        latLngs.push([@lat, @lng]);
                        var icon = L.divIcon({ html: '@order', iconSize: [30, 30], className: 'stop-marker' });
                        L.marker([@lat, @lng], { icon: icon })
                            .bindPopup('<strong>@name</strong><br>Ordre: @order<br>Personnels: @workers')
                            .addTo(map);
                    </text>
                }

                var polyline = L.polyline(latLngs, { color: 'blue', weight: 4, opacity: 0.7 }).addTo(map);
                map.fitBounds(polyline.getBounds());
            </script>
        }
        else
        {
            <script>
                var map = L.map('map').setView([34.2610, -6.5800], 13);
                L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> & CartoDB'
                }).addTo(map);
                L.marker([34.2610, -6.5800]).bindPopup('Fragment sans arrêts').addTo(map);
            </script>
        }
    }
}