@{
    ViewData["Title"] = "Personnel Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .toast-container { z-index: 1055; }
    .toast { min-width: 300px; border-left: 5px solid; }
    .toast.warning { border-left-color: #ffc107; }
    .toast.danger { border-left-color: #dc3545; }
    .toast-header { background-color: #f8f9fa; border-bottom: none; }
    .bus-marker { background-color: #007bff; color: white; border-radius: 50%; text-align: center; font-size: 16px; padding: 6px; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border: 2px solid white; box-shadow: 0 2px 6px rgba(0,0,0,0.3); }
    .stop-marker { background-color: #28a745; color: white; border-radius: 50%; text-align: center; font-size: 12px; padding: 4px; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; border: 1px solid white; }
    .person-marker { background-color: #ffc107; color: black; border-radius: 50%; text-align: center; font-size: 14px; padding: 4px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border: 2px solid white; }
</style>

<h2>Bienvenue, @ViewBag.UserName</h2>
<div id="assignmentInfo" class="alert alert-info">
    Chargement de votre trajet...
</div>

<div id="map" style="height: 600px; width: 100%; border-radius: 10px; margin-bottom: 20px;"></div>

<div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let map, busMarkers = {}, trajectoryLine, personStopMarker, personLocationMarker;
        let lastAlertTypes = {};
        let currentTrajectoryId = null;
        let checkInterval;
        const SPEED_KMH = 30; // km/h

        // ----- Utilitaires -----
        function haversine(lat1, lon1, lat2, lon2) {
            const R = 6371e3;
            const φ1 = lat1 * Math.PI / 180;
            const φ2 = lat2 * Math.PI / 180;
            const Δφ = (lat2 - lat1) * Math.PI / 180;
            const Δλ = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(Δφ/2) * Math.sin(Δφ/2) +
                      Math.cos(φ1) * Math.cos(φ2) *
                      Math.sin(Δλ/2) * Math.sin(Δλ/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        function formatTravelTime(distanceMeters) {
            let hours = distanceMeters / 1000 / SPEED_KMH;
            let minutes = hours * 60;
            if (minutes < 1) return "< 1 min";
            if (minutes < 60) return Math.round(minutes) + " min";
            let hrs = Math.floor(minutes / 60);
            let mins = Math.round(minutes % 60);
            return hrs + " h " + mins + " min";
        }

        // ----- Alertes -----
        function showToast(title, message, type = 'warning') {
            const container = document.getElementById('toastContainer');
            const id = 'toast-' + Date.now();
            const html = `
                <div id="${id}" class="toast ${type}" role="alert" data-bs-autohide="true" data-bs-delay="8000">
                    <div class="toast-header">
                        <strong class="me-auto">🚨 ${title}</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body">${message}</div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);
            const el = document.getElementById(id);
            const toast = new bootstrap.Toast(el, { autohide: true, delay: 8000 });
            toast.show();
            el.addEventListener('hidden.bs.toast', () => el.remove());
        }

        function showBrowserNotification(title, body) {
            if (!("Notification" in window)) return;
            if (Notification.permission === "granted") {
                new Notification(title, { body: body, icon: "/favicon.ico" });
            } else if (Notification.permission !== "denied") {
                Notification.requestPermission();
            }
        }

        function triggerAlert(busCode, distance, alertType) {
            const title = alertType === '200m' ? '⚠️ URGENT : Bus très proche !' : '🔔 Alerte : Bus en approche';
            const message = `Le bus ${busCode} est à ${Math.round(distance)} mètres de votre arrêt.`;
            showToast(title, message, alertType === '200m' ? 'danger' : 'warning');
            showBrowserNotification(title, message);
        }

        // ----- Chargement des données et mise à jour carte -----
        async function loadPersonnelData() {
            try {
                const response = await fetch('/Buses/GetPersonnelDashboardData');
                if (!response.ok) {
                    document.getElementById('assignmentInfo').innerHTML = '<div class="alert alert-danger">Aucune trajectoire assignée active.</div>';
                    return;
                }
                const data = await response.json();

                // Point de référence pour l'ETA : arrêt personnel s'il existe, sinon point de départ de la trajectoire
                let refLat = null, refLng = null;
                if (data.personnelStop) {
                    refLat = data.personnelStop.tS_Latitude;
                    refLng = data.personnelStop.tS_Longitude;
                } else if (data.trajectory && data.trajectory.StartLat && data.trajectory.StartLng) {
                    refLat = data.trajectory.StartLat;
                    refLng = data.trajectory.StartLng;
                }

                document.getElementById('assignmentInfo').innerHTML = `
                    <strong>Trajectoire :</strong> ${data.trajectory.trajectory_Name} (${data.trajectory.trajectory_Code})<br/>
                    <strong>Arrêt personnel :</strong> ${data.personnelStop ? data.personnelStop.tS_Name : 'Non défini (ETA calculé depuis le départ)'}<br/>
                    <strong>Bus sur cette trajectoire :</strong> ${data.buses.length}
                `;
                currentTrajectoryId = data.trajectory.trajectory_Id;

                if (!map) {
                    map = L.map('map').setView([46.603354, 1.888334], 15);
                    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> & CartoDB'
                    }).addTo(map);
                }

                // Tracer la trajectoire (polyline)
                if (trajectoryLine) map.removeLayer(trajectoryLine);
                const points = data.stops.map(s => [s.tS_Latitude, s.tS_Longitude]);
                if (points.length > 1) {
                    trajectoryLine = L.polyline(points, { color: 'blue', weight: 4, opacity: 0.6 }).addTo(map);
                }

                // Ajouter les arrêts
                data.stops.forEach(stop => {
                    const icon = L.divIcon({ html: stop.tS_OrderIndex, iconSize: [24, 24], className: 'stop-marker' });
                    L.marker([stop.tS_Latitude, stop.tS_Longitude], { icon })
                        .bindPopup(`<b>${stop.tS_Name}</b><br/>Ordre ${stop.tS_OrderIndex}`)
                        .addTo(map);
                });

                // Arrêt personnel s'il existe
                if (data.personnelStop) {
                    if (personStopMarker) map.removeLayer(personStopMarker);
                    const icon = L.divIcon({ html: '📍', iconSize: [28, 28], className: 'stop-marker' });
                    personStopMarker = L.marker([data.personnelStop.tS_Latitude, data.personnelStop.tS_Longitude], { icon })
                        .bindPopup(`<b>Votre arrêt : ${data.personnelStop.tS_Name}</b>`)
                        .addTo(map);
                }

                // Bus avec popup (incluant l'ETA)
                if (window.busLayer) map.removeLayer(window.busLayer);
                window.busLayer = L.layerGroup().addTo(map);
                busMarkers = {};
                data.buses.forEach(bus => {
                    const busIcon = L.divIcon({ html: '🚌', iconSize: [30, 30], className: 'bus-marker' });
                    let etaText = "";
                    if (refLat && refLng) {
                        const distToRef = haversine(refLat, refLng, bus.lat, bus.lng);
                        const eta = formatTravelTime(distToRef);
                        etaText = `<br/>🚏 Arrive dans : ${eta}`;
                    }
                    const popupContent = `<b>${bus.bus_Code}</b><br/>Plaque: ${bus.bus_PlateNumber}<br/>Statut: ${bus.bus_Status}${etaText}`;
                    const marker = L.marker([bus.lat, bus.lng], { icon: busIcon })
                        .bindPopup(popupContent)
                        .addTo(window.busLayer);
                    busMarkers[bus.bus_Id] = marker;
                });

                // Centrage : sur l'arrêt personnel, sinon sur le premier bus, avec zoom 15
                if (data.personnelStop) {
                    map.setView([data.personnelStop.tS_Latitude, data.personnelStop.tS_Longitude], 15);
                } else if (data.buses.length > 0) {
                    map.setView([data.buses[0].lat, data.buses[0].lng], 15);
                } else if (data.trajectory.StartLat && data.trajectory.StartLng) {
                    map.setView([data.trajectory.StartLat, data.trajectory.StartLng], 15);
                }

                // Vérification périodique
                if (checkInterval) clearInterval(checkInterval);
                checkInterval = setInterval(() => checkProximity(data, refLat, refLng), 15000);
                await checkProximity(data, refLat, refLng);
            } catch (error) {
                console.error(error);
                document.getElementById('assignmentInfo').innerHTML = '<div class="alert alert-danger">Erreur de chargement.</div>';
            }
        }

        // Vérification de proximité et mise à jour des popups
        async function checkProximity(data, refLat, refLng) {
            if (!data.personnelStop && !(refLat && refLng)) return;
            // Si pas de point de référence, on reste sur arrêt personnel s'il existe, sinon on sort
            if (!data.personnelStop && (!refLat || !refLng)) return;
            const stopLat = data.personnelStop ? data.personnelStop.tS_Latitude : refLat;
            const stopLng = data.personnelStop ? data.personnelStop.tS_Longitude : refLng;

            for (const bus of data.buses) {
                const distance = haversine(stopLat, stopLng, bus.lat, bus.lng);

                // Mettre à jour le popup du bus avec ETA frais
                const marker = busMarkers[bus.bus_Id];
                if (marker) {
                    const eta = formatTravelTime(distance);
                    const newPopup = `<b>${bus.bus_Code}</b><br/>Plaque: ${bus.bus_PlateNumber}<br/>Statut: ${bus.bus_Status}<br/>🚏 Arrive dans : ${eta}`;
                    marker.bindPopup(newPopup);
                }

                // Déclencher alerte si seuil atteint
                let triggerType = null;
                if (distance <= 200 && lastAlertTypes[bus.bus_Id] !== '200m') {
                    triggerType = '200m';
                } else if (distance <= 500 && lastAlertTypes[bus.bus_Id] !== '200m' && lastAlertTypes[bus.bus_Id] !== '500m') {
                    triggerType = '500m';
                }
                if (triggerType) {
                    const res = await fetch('/Buses/CheckProximityAlert', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            busId: bus.bus_Id,
                            busCode: bus.bus_Code,
                            trajectoryId: currentTrajectoryId,
                            distance: distance
                        })
                    });
                    const alertRes = await res.json();
                    if (alertRes.alertType !== 'none') {
                        triggerAlert(bus.bus_Code, distance, alertRes.alertType);
                        lastAlertTypes[bus.bus_Id] = alertRes.alertType;
                    }
                }
            }
        }

        // Géolocalisation du personnel
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(pos => {
                if (!map) return;
                if (personLocationMarker) map.removeLayer(personLocationMarker);
                const icon = L.divIcon({ html: '👤', iconSize: [28, 28], className: 'person-marker' });
                personLocationMarker = L.marker([pos.coords.latitude, pos.coords.longitude], { icon })
                    .bindPopup('Votre position actuelle')
                    .addTo(map);
            });
        }

        // Permission notifications
        if ("Notification" in window && Notification.permission !== "denied") {
            Notification.requestPermission();
        }

        loadPersonnelData();
        setInterval(() => loadPersonnelData(), 30000);
    </script>
}