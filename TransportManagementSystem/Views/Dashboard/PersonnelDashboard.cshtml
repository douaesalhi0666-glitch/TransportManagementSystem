@{
    ViewData["Title"] = "Tableau de bord Personnel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Bienvenue, @ViewBag.UserName !</h2>
<p>Suivez en temps réel la position des bus de la flotte.</p>

<div id="map" style="height: 600px; width: 100%; border-radius: 10px; margin-bottom: 20px;"></div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <style>
        .bus-marker {
        background-color: #007bff;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 16px;
        padding: 6px;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }
    </style>

    <script>
        var map = L.map('map').setView([46.603354, 1.888334], 6);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> & CartoDB'
        }).addTo(map);

        var busIcon = L.divIcon({
        html: '<div>🚌</div>',
        iconSize: [30, 30],
        className: 'bus-marker'
        });

        async function loadBusLocations() {
        try {
        const response = await fetch('/Buses/GetBusLocations');
        const buses = await response.json();
        if (window.busLayer) map.removeLayer(window.busLayer);
        window.busLayer = L.layerGroup().addTo(map);
        buses.forEach(bus => {
        if (bus.lat && bus.lng) {
        const popup = `<strong>${bus.bus_Code}</strong><br/>
        Plaque: ${bus.bus_PlateNumber}<br/>
        Statut: ${bus.bus_Status}<br/>
        Dernière mise à jour: ${bus.lastUpdate ? new Date(bus.lastUpdate).toLocaleString() : 'Inconnue'}`;
        L.marker([bus.lat, bus.lng], { icon: busIcon })
        .bindPopup(popup)
        .addTo(window.busLayer);
        }
        });
        } catch (error) {
        console.error(error);
        }
        }

        loadBusLocations();
        setInterval(loadBusLocations, 30000);
    </script>
}