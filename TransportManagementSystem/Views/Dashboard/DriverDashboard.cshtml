@{
    ViewData["Title"] = "Tableau de bord - Chauffeur";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Bonjour, @ViewBag.UserName</h2>
<p>Bienvenue sur votre tableau de bord chauffeur.</p>

<div class="row mb-4" id="busInfo">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5>🚍 Mon bus</h5>
            </div>
            <div class="card-body">
                <p><strong>Code :</strong> <span id="busCode">-</span></p>
                <p><strong>Plaque :</strong> <span id="busPlate">-</span></p>
                <p><strong>Modèle :</strong> <span id="busModel">-</span></p>
                <p><strong>Statut :</strong> <span id="busStatus">-</span></p>
                <p><strong>Dernière position connue :</strong> <span id="lastUpdate">-</span></p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5>📍 Ma trajectoire</h5>
            </div>
            <div class="card-body">
                <p><strong>Nom :</strong> <span id="trajName">Aucune trajectoire assignée</span></p>
                <p><strong>Code :</strong> <span id="trajCode"></span></p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5>🗺️ Carte de navigation</h5>
            </div>
            <div class="card-body">
                <div id="map" style="height: 500px; width: 100%; border-radius: 10px;"></div>
                <div class="mt-3 text-center">
                    <button id="updateLocationBtn" class="btn btn-primary btn-lg">
                        📍 Mettre à jour ma position actuelle
                    </button>
                    <small class="d-block text-muted mt-2">
                        Cliquez pour envoyer votre position GPS au serveur et mettre à jour la carte.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        .bus-marker {
        background-color: #dc3545;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 20px;
        padding: 6px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }

        .stop-marker {
        background-color: #28a745;
        color: white;
        border-radius: 50%;
        text-align: center;
        font-size: 12px;
        padding: 4px;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid white;
        }
    </style>

    <script>
        let map, busMarker, trajectoryLine;
        let currentBusId = null;

        async function loadDriverData() {
        try {
        const response = await fetch('/Buses/GetDriverDashboardData');
        if (!response.ok) throw new Error('Erreur chargement données');
        const data = await response.json();

        // Mise à jour des infos
        document.getElementById('busCode').innerText = data.bus.bus_Code || '-';
        document.getElementById('busPlate').innerText = data.bus.bus_PlateNumber || '-';
        document.getElementById('busModel').innerText = `${data.bus.bus_Brand || ''} ${data.bus.bus_Model || ''}`.trim() || '-';
        document.getElementById('busStatus').innerText = data.bus.bus_Status || '-';
        document.getElementById('lastUpdate').innerText = data.bus.lastLocationUpdateTime ? new Date(data.bus.lastLocationUpdateTime).toLocaleString() : 'jamais';
        if (data.trajectory) {
        document.getElementById('trajName').innerText = data.trajectory.trajectory_Name;
        document.getElementById('trajCode').innerText = data.trajectory.trajectory_Code;
        } else {
        document.getElementById('trajName').innerText = "Aucune trajectoire assignée";
        }

        currentBusId = data.bus.bus_Id;
        const busLat = parseFloat(data.bus.currentLatitude);
        const busLng = parseFloat(data.bus.currentLongitude);

        // Initialisation de la carte
        if (!map) {
        map = L.map('map').setView([busLat || 46.603354, busLng || 1.888334], 13);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> & CartoDB'
        }).addTo(map);
        }

        // Marqueur du bus
        if (busMarker) map.removeLayer(busMarker);
        const busIcon = L.divIcon({ html: '<div>🚌</div>', iconSize: [40, 40], className: 'bus-marker' });
        if (busLat && busLng) {
        busMarker = L.marker([busLat, busLng], { icon: busIcon }).bindPopup('Ma position actuelle').addTo(map);
        map.setView([busLat, busLng], 13);
        }

        // Tracé de la trajectoire (ligne)
        if (trajectoryLine) map.removeLayer(trajectoryLine);
        if (data.trajectory && data.stops && data.stops.length > 0) {
        const points = data.stops.map(s => [parseFloat(s.tS_Latitude), parseFloat(s.tS_Longitude)]);
        trajectoryLine = L.polyline(points, { color: 'blue', weight: 4, opacity: 0.7 }).addTo(map);
        // Ajout des marqueurs d'arrêts
        data.stops.forEach(stop => {
        const stopIcon = L.divIcon({ html: stop.tS_OrderIndex, iconSize: [24, 24], className: 'stop-marker' });
        L.marker([parseFloat(stop.tS_Latitude), parseFloat(stop.tS_Longitude)], { icon: stopIcon })
        .bindPopup(`<strong>${stop.tS_Name}</strong><br/>Ordre: ${stop.tS_OrderIndex}`)
        .addTo(map);
        });
        }
        } catch (error) {
        console.error(error);
        alert("Impossible de charger les données du chauffeur. Vérifiez que vous êtes bien connecté et qu'un bus vous est assigné.");
        }
        }

        // Mise à jour de la position réelle du bus (géolocalisation)
        document.getElementById('updateLocationBtn').addEventListener('click', () => {
        if (!navigator.geolocation) {
        alert("Votre navigateur ne supporte pas la géolocalisation.");
        return;
        }
        navigator.geolocation.getCurrentPosition(async (position) => {
        const lat = position.coords.latitude;
        const lng = position.coords.longitude;
        try {
        const response = await fetch('/Buses/UpdateBusLocation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ latitude: lat, longitude: lng })
        });
        if (response.ok) {
        alert("Position mise à jour avec succès !");
        loadDriverData(); // Recharge les données et recentre la carte
        } else {
        alert("Erreur lors de la mise à jour.");
        }
        } catch (err) {
        console.error(err);
        alert("Erreur réseau.");
        }
        }, () => {
        alert("Impossible d'obtenir votre position.");
        });
        });

        loadDriverData();
        // Rafraîchir les données toutes les 30 secondes (position du bus vue par les autres)
        setInterval(loadDriverData, 30000);
    </script>
}