@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="alert alert-success shadow-sm">
    <h2>👑 Bonjour, @ViewBag.UserName !</h2>
    <p>Vous êtes connecté en tant qu'<strong>Administrateur</strong> – Tableau de bord central</p>
</div>

<!-- =============================== -->
<!-- 1. Gestion des ressources       -->
<!-- =============================== -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <i class="fas fa-users fa-2x mb-2"></i>
                <h5>Personnel</h5>
                <p>Gérer les employés</p>
                <a href="/Personnel/Index" class="btn btn-light btn-sm">Gérer →</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <i class="fas fa-truck fa-2x mb-2"></i>
                <h5>Chauffeurs</h5>
                <p>Gérer les conducteurs</p>
                <a href="/Drivers/Index" class="btn btn-light btn-sm">Gérer →</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card text-white bg-warning h-100">
            <div class="card-body">
                <i class="fas fa-bus fa-2x mb-2"></i>
                <h5>Bus</h5>
                <p>Gérer le parc automobile</p>
                <a href="/Buses/Index" class="btn btn-light btn-sm">Gérer →</a>
                <hr class="bg-light">
                <a href="/TrajectoryAssignment/BusOccupancy" class="btn btn-outline-light btn-sm w-100 mt-1">
                    📊 Occupation des bus
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card text-white bg-info h-100">
            <div class="card-body">
                <i class="fas fa-map-marked-alt fa-2x mb-2"></i>
                <h5>Trajets</h5>
                <p>Gérer les itinéraires</p>
                <a href="/Trajectories/Index" class="btn btn-light btn-sm">Gérer →</a>
            </div>
        </div>
    </div>
</div>

<!-- =============================== -->
<!-- 2. Assignations principales      -->
<!-- =============================== -->
<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card border-secondary h-100">
            <div class="card-header bg-secondary text-white">
                <i class="fas fa-user-cog"></i> Assigner chauffeurs ↔ bus
            </div>
            <div class="card-body">
                <p>Affecter un conducteur à un bus</p>
                <a href="/Assignments" class="btn btn-primary btn-sm">Accéder →</a>
            </div>
        </div>
    </div>
</div>

<!-- =============================== -->
<!-- 3. Gestion des points de ramassage -->
<!-- =============================== -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card text-center border-0 shadow-sm" style="background: #f8f9fa;">
            <div class="card-body">
                <span class="badge bg-dark px-3 py-2">📍 Gestion des points de ramassage</span>
                <h6 class="mt-2">Définir, visualiser et assigner les personnels aux arrêts</h6>
                <a href="/Clustering/DefinePickupPoints" class="btn btn-outline-dark btn-sm">Accéder à la gestion des points de ramassage →</a>
            </div>
        </div>
    </div>
</div>
<!-- =============================== -->
<!-- 4. Détection d'anomalies         -->
<!-- =============================== -->
<div id="anomaly-section" class="row mb-4">
    <div class="col-12">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5>⚠️ Détection d'anomalies</h5>
            </div>
            <div class="card-body">
                <button id="runAnomalyDetectionBtn" class="btn btn-danger">🔍 Lancer la détection</button>
                <div id="anomalyResult" class="mt-2"></div>
                <hr>
                <a href="/Anomaly/Index" class="btn btn-outline-danger">📋 Voir les anomalies détectées</a>
            </div>
        </div>
    </div>
</div>

<!-- =============================== -->
<!-- 5. Déconnexion                  -->
<!-- =============================== -->
<div class="row mt-4 mb-5">
    <div class="col-12 text-center">
        <a href="/Account/Logout" class="btn btn-danger btn-lg">🔓 Se déconnecter</a>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script>
        document.getElementById('runAnomalyDetectionBtn')?.addEventListener('click', async function () {
        const btn = this;
        const resultDiv = document.getElementById('anomalyResult');
        btn.disabled = true;
        btn.innerHTML = '⏳ Détection en cours...';
        try {
        const response = await fetch('/Dashboard/RunAnomalyDetection', { method: 'POST' });
        const data = await response.json();
        if (data.success) {
        resultDiv.innerHTML = `<div class="alert alert-success">✅ ${data.message}</div>`;
        } else {
        resultDiv.innerHTML = `<div class="alert alert-danger">❌ ${data.message}</div>`;
        }
        } catch (err) {
        resultDiv.innerHTML = `<div class="alert alert-danger">Erreur réseau</div>`;
        } finally {
        btn.disabled = false;
        btn.innerHTML = '🔍 Lancer la détection';
        }
        });
    </script>
}