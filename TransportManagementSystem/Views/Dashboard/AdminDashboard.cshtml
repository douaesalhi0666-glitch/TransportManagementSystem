@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="alert alert-success shadow-sm">
        <h2>👑 Bonjour, @ViewBag.UserName !</h2>
        <p>Vous êtes connecté en tant qu'<strong>Administrateur</strong> – Tableau de bord central</p>
    </div>

    <!-- Gestion des ressources -->
    <div class="row">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body">
                    <i class="fas fa-users fa-2x mb-2"></i>
                    <h5>Personnel</h5>
                    <p>Gérer les employés</p>
                    <a href="/Personnel/Index" class="btn btn-light btn-sm">Gérer →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success h-100">
                <div class="card-body">
                    <i class="fas fa-truck fa-2x mb-2"></i>
                    <h5>Chauffeurs</h5>
                    <p>Gérer les conducteurs</p>
                    <a href="/Drivers/Index" class="btn btn-light btn-sm">Gérer →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning h-100">
                <div class="card-body">
                    <i class="fas fa-bus fa-2x mb-2"></i>
                    <h5>Bus</h5>
                    <p>Gérer le parc automobile</p>
                    <a href="/Buses/Index" class="btn btn-light btn-sm">Gérer →</a>
                    <hr class="bg-light">
                    <a href="/TrajectoryAssignment/BusOccupancy" class="btn btn-outline-light btn-sm w-100 mt-1">
                        📊 Occupation des bus
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body">
                    <i class="fas fa-map-marked-alt fa-2x mb-2"></i>
                    <h5>Trajets</h5>
                    <p>Gérer les itinéraires</p>
                    <a href="/Trajectories/Index" class="btn btn-light btn-sm">Gérer →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Assignations -->
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card border-secondary h-100">
                <div class="card-header bg-secondary text-white">
                    <i class="fas fa-user-cog"></i> Assigner chauffeurs ↔ bus
                </div>
                <div class="card-body">
                    <p>Affecter un conducteur à un bus</p>
                    <a href="/Assignments" class="btn btn-primary btn-sm">Accéder →</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card border-secondary h-100">
                <div class="card-header bg-secondary text-white">
                    <i class="fas fa-user-plus"></i> Assigner personnel (auto)
                </div>
                <div class="card-body">
                    <p>Assignation automatique ou manuelle du personnel à un trajet/bus.</p>
                    <a href="/TrajectoryAssignment/AssignPersonnel" class="btn btn-primary btn-sm">Accéder →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- IA Recommandations et Gestion des points de ramassage -->
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card text-center border-0 shadow-sm" style="background: #f8f9fa;">
                <div class="card-body">
                    <span class="badge bg-primary px-3 py-2">🤖 IA Recommandations</span>
                    <h6 class="mt-2">Optimisation intelligente des tournées et affectations</h6>
                    <a href="/AIRecommendation/Index" class="btn btn-outline-primary btn-sm">Accéder aux recommandations →</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card text-center border-0 shadow-sm" style="background: #f8f9fa;">
                <div class="card-body">
                    <span class="badge bg-dark px-3 py-2">📍 Gestion des points de ramassage</span>
                    <h6 class="mt-2">Définir, visualiser et assigner les personnels aux arrêts</h6>
                    <a href="/Clustering/DispatcherView" class="btn btn-outline-dark btn-sm">Accéder à la gestion des points de ramassage →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- NOUVEAU: Gestion des Fragments de Trajet -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card border-info">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-puzzle-piece"></i> Gestion des Fragments de Trajet
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <div class="d-grid">
                                <a href="/Fragment/Index" class="btn btn-outline-info btn-lg">
                                    🧩 Générer fragments
                                </a>
                                <small class="text-muted mt-1">Créer des fragments par capacité (20 pers.)</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Déconnexion -->
    <div class="row mt-4 mb-5">
        <div class="col-12 text-center">
            <a href="/Account/Logout" class="btn btn-danger">🔓 Se déconnecter</a>
        </div>
    </div>
</div>