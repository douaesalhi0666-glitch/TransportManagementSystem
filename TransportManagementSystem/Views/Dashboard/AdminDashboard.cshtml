@{
    ViewData["Title"] = "Tableau de bord";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dash-bg {
        background: linear-gradient(135deg, #0f1c2e 0%, #1e3250 100%);
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
    }

        .dash-bg::before {
            content: '';
            position: absolute;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            border: 50px solid rgba(245,166,35,0.06);
            top: -100px;
            right: -80px;
            pointer-events: none;
        }

        .dash-bg::after {
            content: '';
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%);
            bottom: -40px;
            left: 40px;
            pointer-events: none;
        }

        .dash-bg h1 {
            font-size: 1.45rem;
            font-weight: 700;
            color: #fff;
            margin: 0 0 6px;
        }

        .dash-bg p {
            font-size: 0.85rem;
            color: #8da0b8;
            margin: 0;
        }

    .dash-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(245,166,35,0.15);
        border: 1px solid rgba(245,166,35,0.3);
        color: #f5a623;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 14px;
    }

    .res-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        transition: box-shadow 0.18s, transform 0.18s;
        height: 100%;
    }

        .res-card:hover {
            box-shadow: 0 6px 24px rgba(37,99,235,0.12);
            transform: translateY(-2px);
            text-decoration: none;
        }

    .res-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .res-card__label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #94a3b8;
        font-weight: 600;
    }

    .res-card__title {
        font-family: 'Sora', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
    }

    .workflow-title {
        font-family: 'Sora', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: #64748b;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .workflow-title::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e2e8f0;
        }

    .workflow-steps {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .wf-step {
        display: flex;
        gap: 0;
        position: relative;
    }

        .wf-step:not(:last-child) .wf-line {
            position: absolute;
            left: 23px;
            top: 52px;
            width: 2px;
            bottom: 0;
            background: linear-gradient(to bottom, #3b82f6, #e2e8f0);
            z-index: 0;
        }

    .wf-num-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 48px;
        flex-shrink: 0;
        padding-top: 14px;
        position: relative;
        z-index: 1;
    }

    .wf-num {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #1d4ed8, #3b82f6);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Sora', sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        color: #fff;
        box-shadow: 0 4px 12px rgba(59,130,246,0.35);
        flex-shrink: 0;
    }

    .wf-card {
        flex: 1;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 14px;
        margin-left: 12px;
        transition: box-shadow 0.18s, border-color 0.18s;
        position: relative;
        overflow: hidden;
    }

        .wf-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(to bottom, #1d4ed8, #3b82f6);
            border-radius: 4px 0 0 4px;
        }

        .wf-card:hover {
            box-shadow: 0 6px 24px rgba(59,130,246,0.1);
            border-color: #bfdbfe;
        }

    .wf-card__head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 8px;
    }

    .wf-card__icon {
        width: 38px;
        height: 38px;
        background: #eff6ff;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        color: #2563eb;
        flex-shrink: 0;
    }

    .wf-card__title {
        font-family: 'Sora', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 3px;
    }

    .wf-card__desc {
        font-size: 0.8rem;
        color: #64748b;
        line-height: 1.5;
    }

    .wf-card__tag {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        padding: 3px 9px;
        border-radius: 20px;
        background: #eff6ff;
        color: #2563eb;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .wf-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        padding: 7px 16px;
        background: #1d4ed8;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s;
        font-family: 'Sora', sans-serif;
    }

        .wf-btn:hover {
            background: #1e40af;
            color: #fff;
            text-decoration: none;
        }

    .anomaly-card {
        background: linear-gradient(135deg, #fff5f5, #fff);
        border: 1px solid #fecaca;
        border-radius: 14px;
        padding: 22px 26px;
        position: relative;
        overflow: hidden;
    }

        .anomaly-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(to bottom, #ef4444, #f87171);
            border-radius: 4px 0 0 4px;
        }
</style>

<!-- Hero banner -->
<div class="dash-bg">
    <div class="position-relative" style="z-index:1;">
        <div class="dash-badge"><i class="fas fa-gauge-high"></i> Administration</div>
        <h1>Bonjour, @ViewBag.UserName !</h1>
        <p>Suivez le guide ci-dessous pour configurer et superviser votre système de transport.</p>
    </div>
</div>

<!-- Resources -->
<div class="workflow-title">Ressources</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a href="/Personnel/Index" class="res-card">
            <div class="res-icon" style="background:#eff6ff;"><i class="fas fa-users" style="color:#2563eb;"></i></div>
            <div><div class="res-card__label">Gérer</div><div class="res-card__title">Personnel</div></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="/Drivers/Index" class="res-card">
            <div class="res-icon" style="background:#f0fdf4;"><i class="fas fa-id-card" style="color:#16a34a;"></i></div>
            <div><div class="res-card__label">Gérer</div><div class="res-card__title">Chauffeurs</div></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="/Buses/Index" class="res-card">
            <div class="res-icon" style="background:#fffbeb;"><i class="fas fa-bus" style="color:#d97706;"></i></div>
            <div><div class="res-card__label">Gérer</div><div class="res-card__title">Bus</div></div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="/Trajectories/Index" class="res-card">
            <div class="res-icon" style="background:#f0f9ff;"><i class="fas fa-route" style="color:#0284c7;"></i></div>
            <div><div class="res-card__label">Gérer</div><div class="res-card__title">Trajets</div></div>
        </a>
    </div>
</div>

<!-- Workflow steps -->
<div class="workflow-title">Guide de configuration — étapes à suivre</div>
<div class="workflow-steps mb-4">

    <!-- Step 1 -->
    <div class="wf-step">
        <div class="wf-line"></div>
        <div class="wf-num-col"><div class="wf-num">1</div></div>
        <div class="wf-card">
            <div class="wf-card__head">
                <div class="d-flex align-items-center gap-3">
                    <div class="wf-card__icon"><i class="fas fa-link"></i></div>
                    <div>
                        <div class="wf-card__title">Assigner les chauffeurs aux bus</div>
                        <div class="wf-card__desc">Commencez par associer chaque conducteur à un véhicule de la flotte. Sans cette étape, aucune opération de transport ne peut démarrer.</div>
                    </div>
                </div>
                <span class="wf-card__tag">Étape 1</span>
            </div>
            <a href="/Assignments/Index" class="wf-btn"><i class="fas fa-arrow-right"></i> Faire les assignations</a>
        </div>
    </div>

    <!-- Step 2 -->
    <div class="wf-step">
        <div class="wf-line"></div>
        <div class="wf-num-col"><div class="wf-num">2</div></div>
        <div class="wf-card">
            <div class="wf-card__head">
                <div class="d-flex align-items-center gap-3">
                    <div class="wf-card__icon"><i class="fas fa-map-pin"></i></div>
                    <div>
                        <div class="wf-card__title">Définir les points de ramassage</div>
                        <div class="wf-card__desc">Positionnez les arrêts de ramassage sur la carte. Le système utilisera ces points pour optimiser les trajets et regrouper le personnel.</div>
                    </div>
                </div>
                <span class="wf-card__tag">Étape 2</span>
            </div>
            <a href="/Clustering/DefinePickupPoints" class="wf-btn"><i class="fas fa-arrow-right"></i> Définir les points</a>
        </div>
    </div>

    <!-- Step 3 -->
    <div class="wf-step">
        <div class="wf-line"></div>
        <div class="wf-num-col"><div class="wf-num">3</div></div>
        <div class="wf-card">
            <div class="wf-card__head">
                <div class="d-flex align-items-center gap-3">
                    <div class="wf-card__icon"><i class="fas fa-map-location-dot"></i></div>
                    <div>
                        <div class="wf-card__title">Gestion des arrêts</div>
                        <div class="wf-card__desc">Une fois les points définis, affectez le personnel aux arrêts correspondants et validez la répartition via la vue dispatcher.</div>
                    </div>
                </div>
                <span class="wf-card__tag">Étape 3</span>
            </div>
            <a href="/Clustering/DispatcherView" class="wf-btn"><i class="fas fa-arrow-right"></i> Gérer les arrêts</a>
        </div>
    </div>

    <!-- Step 4 -->
    <div class="wf-step">
        <div class="wf-num-col">
            <div class="wf-num">4</div>
        </div>
        <div class="wf-card">
            <div class="wf-card__head">
                <div class="d-flex align-items-center gap-3">
                    <div class="wf-card__icon"><i class="fas fa-chart-bar"></i></div>
                    <div>
                        <div class="wf-card__title">Vérifier l'occupation des bus</div>
                        <div class="wf-card__desc">Consultez le taux de remplissage de chaque bus après les assignations. Assurez-vous qu'aucun véhicule n'est surchargé ou sous-utilisé.</div>
                    </div>
                </div>
                <span class="wf-card__tag">Étape 4</span>
            </div>
            <a href="/TrajectoryAssignment/BusOccupancy" class="wf-btn"><i class="fas fa-arrow-right"></i> Voir l'occupation</a>
        </div>
    </div>

</div>

<!-- Anomaly Detection -->
<div class="workflow-title">Supervision</div>
<div class="anomaly-card mb-5">
    <div class="d-flex align-items-start gap-3 mb-3">
        <div style="width:42px;height:42px;background:#fef2f2;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fas fa-triangle-exclamation" style="color:#ef4444;font-size:1rem;"></i>
        </div>
        <div>
            <div style="font-family:'Sora',sans-serif;font-weight:700;color:#0f172a;font-size:0.95rem;margin-bottom:3px;">Détection d'anomalies</div>
            <div style="font-size:0.8rem;color:#64748b;line-height:1.5;">Lancez le moteur IA pour analyser les données de la flotte et identifier tout comportement anormal (retards, surconsommation, écarts de trajet).</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button id="runAnomalyDetectionBtn" class="btn btn-danger btn-sm">
            <i class="fas fa-magnifying-glass me-1"></i> Lancer la détection
        </button>
        <a href="/Anomaly/Index" class="btn btn-outline-danger btn-sm">
            <i class="fas fa-list me-1"></i> Voir les anomalies détectées
        </a>
    </div>
    <div id="anomalyResult" class="mt-3"></div>
</div>

@section Scripts {
    <script>
        document.getElementById('runAnomalyDetectionBtn')?.addEventListener('click', async function () {
            const btn = this;
            const resultDiv = document.getElementById('anomalyResult');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Détection en cours...';
            try {
                const response = await fetch('/Dashboard/RunAnomalyDetection', { method: 'POST' });
                const data = await response.json();
                resultDiv.innerHTML = data.success
                    ? `<div class="alert alert-success py-2 px-3" style="font-size:.85rem;"><i class="fas fa-circle-check me-2"></i>${data.message}</div>`
                    : `<div class="alert alert-danger py-2 px-3" style="font-size:.85rem;"><i class="fas fa-circle-xmark me-2"></i>${data.message}</div>`;
            } catch {
                resultDiv.innerHTML = `<div class="alert alert-danger py-2 px-3" style="font-size:.85rem;">Erreur réseau.</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-magnifying-glass me-1"></i> Lancer la détection';
            }
        });
    </script>
}