@model IEnumerable<TransportManagementSystem.Models.Personnel>

@{
    ViewData["Title"] = "Personnel";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pickupPoints = ViewBag.PickupPoints as IEnumerable<TransportManagementSystem.Models.TrajectoryStop>;
}

<style>
    .table th, .table td {
        vertical-align: middle;
        white-space: normal;
        word-wrap: break-word;
    }

    .table {
        font-size: 13px;
    }

    .badge-active {
        background-color: #28a745;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
    }

    .badge-inactive {
        background-color: #dc3545;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
    }

    .badge-motorized {
        background-color: #17a2b8;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
    }

    .badge-non-motorized {
        background-color: #6c757d;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
    }

    .badge-pickup {
        background-color: #fd7e14;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
    }

    .filter-bar {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .action-buttons {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

    .table-responsive {
        overflow-x: auto;
    }
</style>

<h1>📋 Gestion du Personnel</h1>

<p>
    <a href="/Personnel/Create" class="btn btn-primary">➕ Ajouter un personnel</a>
</p>

<div class="filter-bar">
    <div class="row">
        <div class="col-md-4 mb-2">
            <input type="text" id="searchInput" class="form-control" placeholder="🔍 Rechercher par ID, prénom ou nom" />
        </div>
        <div class="col-md-2 mb-2">
            <select id="statusFilter" class="form-select">
                <option value="">📊 Tous les statuts</option>
                <option value="Active">✅ Actif</option>
                <option value="Inactive">❌ Inactif</option>
            </select>
        </div>
        <div class="col-md-2 mb-2">
            <select id="assignedFilter" class="form-select">
                <option value="">👥 Tous</option>
                <option value="assigned">✅ Assigné</option>
                <option value="unassigned">❌ Non assigné</option>
            </select>
        </div>
        <div class="col-md-2 mb-2">
            <button id="resetFilter" class="btn btn-secondary w-100">⟳ Réinitialiser</button>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered" id="personnelTable">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Prénom</th>
                <th>Nom</th>
                <th>📍 Point de ramassage</th>
                <th>📌 Trajet</th>
                <th>🚌 Bus</th>
                <th>Statut</th>
                <th>Motorisé</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var isAssigned = item.AssignedBusId != null || item.AssignedTrajectoryId != null;
                var assignedStop = pickupPoints?.FirstOrDefault(s => s.TS_Id == item.AssignedStopId);
                var assignedStopName = assignedStop?.TS_Name ?? "-";
                
                <tr id="row-@item.Personnel_Id" data-status="@item.Personnel_Status" data-assigned="@(isAssigned ? "assigned" : "unassigned")">
                    <td>@item.Personnel_Id</td>
                    <td>@item.Personnel_FirstName</td>
                    <td>@item.Personnel_LastName</td>
                    <td>
                        @if (assignedStop != null)
                        {
                            <span class="badge badge-pickup">📍 @assignedStop.TS_Name</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (item.AssignedTrajectory != null)
                        {
                            @item.AssignedTrajectory.Trajectory_Name
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (item.AssignedBus != null)
                        {
                            @item.AssignedBus.Bus_Code
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (item.Personnel_Status == "Active")
                        {
                            <span class="badge-active">✅ Actif</span>
                        }
                        else
                        {
                            <span class="badge-inactive">❌ Inactif</span>
                        }
                    </td>
                    <td>
                        @if (item.IsMotorized)
                        {
                            <span class="badge-motorized">🛵 Oui</span>
                        }
                        else
                        {
                            <span class="badge-non-motorized">🚶 Non</span>
                        }
                    </td>
                    <td class="action-buttons">
                        <button class="btn btn-sm btn-info details-btn" data-id="@item.Personnel_Id" title="Voir détails">🔍 Détails</button>
                        <button class="btn btn-sm btn-warning edit-btn" data-id="@item.Personnel_Id" title="Modifier">✏️ Modifier</button>
                        <a href="/Personnel/Delete/@item.Personnel_Id" class="btn btn-sm btn-danger" title="Supprimer">🗑️ Supprimer</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a href="/Dashboard/AdminDashboard" class="btn btn-secondary">← Retour au Dashboard</a>
</div>

<!-- Modal d'édition (SANS assignations) -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editModalLabel">✏️ Modifier le personnel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="edit_Personnel_Id" name="Personnel_Id" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Prénom</label>
                            <input type="text" id="edit_FirstName" name="Personnel_FirstName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Nom</label>
                            <input type="text" id="edit_LastName" name="Personnel_LastName" class="form-control" required />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <label class="fw-bold">Genre</label>
                            <select id="edit_Gender" name="Personnel_Gender" class="form-select">
                                <option value="Male">👨 Homme</option>
                                <option value="Female">👩 Femme</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="fw-bold">Date de naissance</label>
                            <input type="date" id="edit_DateOfBirth" name="Personnel_DateOfBirth" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="fw-bold">Statut</label>
                            <select id="edit_Status" name="Personnel_Status" class="form-select">
                                <option value="Active">✅ Actif</option>
                                <option value="Inactive">❌ Inactif</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Email</label>
                            <input type="email" id="edit_Email" name="Personnel_Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Téléphone</label>
                            <input type="text" id="edit_PhoneNumber" name="Personnel_PhoneNumber" class="form-control" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Code employé</label>
                            <input type="text" id="edit_EmployeeCode" name="Personnel_EmployeeCode" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Département</label>
                            <input type="text" id="edit_Department" name="Personnel_Department" class="form-control" />
                        </div>
                    </div>
                    
                    <div class="mb-2">
                        <label class="fw-bold">Adresse domicile</label>
                        <input type="text" id="edit_HomeAddress" name="HomeAddress" class="form-control" placeholder="Rue, numéro, quartier" />
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Adresse (rue)</label>
                            <input type="text" id="edit_Address" name="Personnel_Address" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Ville</label>
                            <input type="text" id="edit_City" name="Personnel_City" class="form-control" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Latitude</label>
                            <input type="number" step="any" id="edit_Latitude" name="Personnel_Latitude" class="form-control" placeholder="Ex: 34.2610" />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="fw-bold">Longitude</label>
                            <input type="number" step="any" id="edit_Longitude" name="Personnel_Longitude" class="form-control" placeholder="Ex: -6.5800" />
                        </div>
                    </div>
                    
                    <div class="form-check mb-2">
                        <input type="checkbox" id="edit_IsMotorized" name="IsMotorized" class="form-check-input" value="true" />
                        <label class="form-check-label fw-bold">🛵 Motorisé (véhicule personnel)</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" id="saveEditBtn" class="btn btn-primary">💾 Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Détails Personnel -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="detailsModalLabel">📋 Détails du personnel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="detailsContent" class="row">
                    <div class="col-12 text-center">Chargement...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            function filterTable() {
                var searchText = $('#searchInput').val().toLowerCase();
                var status = $('#statusFilter').val();
                var assigned = $('#assignedFilter').val();

                $('#personnelTable tbody tr').each(function() {
                    var id = $(this).find('td:first').text();
                    var firstName = $(this).find('td:nth-child(2)').text();
                    var lastName = $(this).find('td:nth-child(3)').text();
                    var rowStatus = $(this).data('status');
                    var rowAssigned = $(this).data('assigned');
                    var matchSearch = (id.toLowerCase().indexOf(searchText) !== -1) ||
                        (firstName.toLowerCase().indexOf(searchText) !== -1) ||
                        (lastName.toLowerCase().indexOf(searchText) !== -1);
                    var matchStatus = (status === '' || rowStatus === status);
                    var matchAssigned = (assigned === '' || rowAssigned === assigned);
                    if (matchSearch && matchStatus && matchAssigned) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            $('#searchInput').on('keyup', filterTable);
            $('#statusFilter').on('change', filterTable);
            $('#assignedFilter').on('change', filterTable);
            $('#resetFilter').click(function() {
                $('#searchInput').val('');
                $('#statusFilter').val('');
                $('#assignedFilter').val('');
                filterTable();
            });

            // Details button click
            $('.details-btn').click(function() {
                var id = $(this).data('id');
                $.get('/Personnel/GetPersonnelData/' + id, function(data) {
                    var html = `
                        <div class="col-md-6">
                            <div class="card details-card">
                                <div class="card-header bg-primary text-white">Informations personnelles</div>
                                <div class="card-body">
                                    <p><strong>ID:</strong> ${data.personnel_Id}</p>
                                    <p><strong>Prénom:</strong> ${data.personnel_FirstName}</p>
                                    <p><strong>Nom:</strong> ${data.personnel_LastName}</p>
                                    <p><strong>Genre:</strong> ${data.personnel_Gender === 'Male' ? '👨 Homme' : (data.personnel_Gender === 'Female' ? '👩 Femme' : data.personnel_Gender)}</p>
                                    <p><strong>Date de naissance:</strong> ${data.personnel_DateOfBirth ? new Date(data.personnel_DateOfBirth).toLocaleDateString() : '-'}</p>
                                    <p><strong>Email:</strong> ${data.personnel_Email || '-'}</p>
                                    <p><strong>Téléphone:</strong> ${data.personnel_PhoneNumber || '-'}</p>
                                    <p><strong>Code employé:</strong> ${data.personnel_EmployeeCode}</p>
                                    <p><strong>Département:</strong> ${data.personnel_Department || '-'}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card details-card">
                                <div class="card-header bg-success text-white">Adresse et localisation</div>
                                <div class="card-body">
                                    <p><strong>Adresse domicile:</strong> ${data.homeAddress || '-'}</p>
                                    <p><strong>Adresse (rue):</strong> ${data.personnel_Address || '-'}</p>
                                    <p><strong>Ville:</strong> ${data.personnel_City || '-'}</p>
                                    <p><strong>Latitude:</strong> ${data.personnel_Latitude || '-'}</p>
                                    <p><strong>Longitude:</strong> ${data.personnel_Longitude || '-'}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="card details-card">
                                <div class="card-header bg-warning text-dark">Assignations et statut</div>
                                <div class="card-body">
                                    <p><strong>Statut:</strong> ${data.personnel_Status === 'Active' ? '✅ Actif' : '❌ Inactif'}</p>
                                    <p><strong>Motorisé:</strong> ${data.isMotorized ? '🛵 Oui' : '🚶 Non'}</p>
                                    <p><strong>Assigné:</strong> ${data.isAssigned ? '✅ Oui' : '❌ Non'}</p>
                                    <p><strong>📍 Point de ramassage:</strong> ${data.assignedStopId || 'Non assigné'}</p>
                                    <p><strong>📌 Trajet assigné:</strong> ${data.assignedTrajectoryId || 'Non assigné'}</p>
                                    <p><strong>🚌 Bus assigné:</strong> ${data.assignedBusId || 'Non assigné'}</p>
                                </div>
                            </div>
                        </div>
                    `;
                    $('#detailsContent').html(html);
                    $('#detailsModal').modal('show');
                }).fail(function() {
                    $('#detailsContent').html('<div class="col-12 text-center text-danger">❌ Erreur lors du chargement des données.</div>');
                    $('#detailsModal').modal('show');
                });
            });

            // Edit button click
            $('.edit-btn').click(function() {
                var id = $(this).data('id');
                $.get('/Personnel/GetPersonnelData/' + id, function(data) {
                    $('#edit_Personnel_Id').val(data.personnel_Id);
                    $('#edit_FirstName').val(data.personnel_FirstName);
                    $('#edit_LastName').val(data.personnel_LastName);
                    $('#edit_Gender').val(data.personnel_Gender);
                    var dob = data.personnel_DateOfBirth ? data.personnel_DateOfBirth.split('T')[0] : '';
                    $('#edit_DateOfBirth').val(dob);
                    $('#edit_PhoneNumber').val(data.personnel_PhoneNumber);
                    $('#edit_Email').val(data.personnel_Email);
                    $('#edit_EmployeeCode').val(data.personnel_EmployeeCode);
                    $('#edit_Department').val(data.personnel_Department);
                    $('#edit_Status').val(data.personnel_Status);
                    $('#edit_Address').val(data.personnel_Address);
                    $('#edit_City').val(data.personnel_City);
                    $('#edit_Latitude').val(data.personnel_Latitude);
                    $('#edit_Longitude').val(data.personnel_Longitude);
                    $('#edit_HomeAddress').val(data.homeAddress);
                    $('#edit_IsMotorized').prop('checked', data.isMotorized === true);
                    $('#editModal').modal('show');
                }).fail(function() {
                    alert('❌ Erreur lors du chargement des données.');
                });
            });

            $('#saveEditBtn').click(function() {
                var formData = {
                    Personnel_Id: $('#edit_Personnel_Id').val(),
                    Personnel_FirstName: $('#edit_FirstName').val(),
                    Personnel_LastName: $('#edit_LastName').val(),
                    Personnel_Gender: $('#edit_Gender').val(),
                    Personnel_DateOfBirth: $('#edit_DateOfBirth').val() || null,
                    Personnel_PhoneNumber: $('#edit_PhoneNumber').val(),
                    Personnel_Email: $('#edit_Email').val(),
                    Personnel_EmployeeCode: $('#edit_EmployeeCode').val(),
                    Personnel_Department: $('#edit_Department').val(),
                    Personnel_Status: $('#edit_Status').val(),
                    Personnel_Address: $('#edit_Address').val(),
                    Personnel_City: $('#edit_City').val(),
                    Personnel_Latitude: $('#edit_Latitude').val() === '' ? null : parseFloat($('#edit_Latitude').val()),
                    Personnel_Longitude: $('#edit_Longitude').val() === '' ? null : parseFloat($('#edit_Longitude').val()),
                    HomeAddress: $('#edit_HomeAddress').val(),
                    IsMotorized: $('#edit_IsMotorized').is(':checked')
                };

                $.ajax({
                    url: '/Personnel/UpdatePersonnel',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function(response) {
                        if (response.success) {
                            alert('✅ ' + response.message);
                            location.reload();
                        } else {
                            alert('❌ Erreur : ' + (response.message || 'Vérifiez les données'));
                        }
                    },
                    error: function() {
                        alert('❌ Erreur lors de l\'envoi.');
                    }
                });
            });
        });
    </script>
}